---
import "../styles/KontakPKBM.css";

const whatsappUrl = "https://wa.me/6285319485269";
const email = "alfatihahhomeschooling@gmail.com";
const alamat =
  "PKBM Alfatihah Semarang, Jl. Ngablak Indah II No. 24A, Bangetayu Kulon, Kec. Genuk, Kota Semarang, Jawa Tengah 50115.";
const nomorRekening = "7266356026";
const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent(alamat);
const mapsEmbedUrl =
  "https://www.google.com/maps?q=" + encodeURIComponent(alamat) + "&output=embed";

// Ikon outline (gaya Lucide)
const icons = {
  whatsapp:
    '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />',
  email:
    '<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />',
  alamat:
    '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" /><circle cx="12" cy="10" r="3" />',
  bank:
    '<line x1="3" x2="21" y1="22" y2="22" /><line x1="6" x2="6" y1="18" y2="11" /><line x1="10" x2="10" y1="18" y2="11" /><line x1="14" x2="14" y1="18" y2="11" /><line x1="18" x2="18" y1="18" y2="11" /><polygon points="12 2 20 7 4 7" />',
  rekening:
    '<rect width="20" height="14" x="2" y="5" rx="2" /><line x1="2" x2="22" y1="10" y2="10" />',
  nama: '<circle cx="12" cy="8" r="5" /><path d="M20 21a8 8 0 0 0-16 0" />',
  tunai:
    '<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1" /><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4" />',
  luarNegeri:
    '<circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />',
  info: '<circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" />',
  copy: '<rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />',
};
---

<section class="kontak-page" aria-labelledby="kontak-page-title">
  <div class="kontak-page-container">
    <header class="kontak-page-heading">
      <h1 id="kontak-page-title">Hubungi Kami</h1>
      <div class="kontak-page-accent"></div>
      <p>Hubungi nomor di bawah ini untuk informasi dan konsultasi lebih lanjut.</p>
    </header>

    <div class="kontak-page-grid">
      <section class="kontak-page-block" aria-labelledby="kontak-info-title">
        <h2 id="kontak-info-title">Kontak</h2>
        <ul class="kontak-page-list">
          <li class="kontak-page-item">
            <span class="kontak-page-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icons.whatsapp} />
            </span>
            <div class="kontak-page-body">
              <span class="kontak-page-label">WhatsApp CS</span>
              <a
                class="kontak-page-value"
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                +62 853-1948-5269
              </a>
              <span class="kontak-page-desc">
                Layanan konsultasi pendaftaran dalam dan luar negeri.
              </span>
            </div>
          </li>
          <li class="kontak-page-item">
            <span class="kontak-page-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icons.email} />
            </span>
            <div class="kontak-page-body">
              <span class="kontak-page-label">Email</span>
              <a class="kontak-page-value" href={`mailto:${email}`}>{email}</a>
            </div>
          </li>
          <li class="kontak-page-item">
            <span class="kontak-page-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icons.alamat} />
            </span>
            <div class="kontak-page-body">
              <span class="kontak-page-label">Alamat</span>
              <span class="kontak-page-value">{alamat}</span>
              <div class="kontak-page-map">
                <iframe
                  src={mapsEmbedUrl}
                  title="Peta lokasi PKBM Alfatihah Semarang"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  tabindex="-1"></iframe>
                <a
                  class="kontak-page-map-link"
                  href={mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Buka lokasi PKBM Alfatihah Semarang di Google Maps"
                ></a>
              </div>
            </div>
          </li>
        </ul>
      </section>

      <section
        class="kontak-page-block kontak-page-payment"
        aria-labelledby="kontak-payment-title"
      >
        <h2 id="kontak-payment-title">Pembayaran</h2>
        <ul class="kontak-page-list">
          <li class="kontak-page-item">
            <span class="kontak-page-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icons.bank} />
            </span>
            <div class="kontak-page-body">
              <span class="kontak-page-label">Bank</span>
              <span class="kontak-page-value">BSI</span>
            </div>
          </li>
          <li class="kontak-page-item">
            <span class="kontak-page-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icons.rekening} />
            </span>
            <div class="kontak-page-body">
              <span class="kontak-page-label">Nomor Rekening</span>
              <div class="kontak-page-account">
                <span class="kontak-page-account-number">{nomorRekening}</span>
                <button
                  type="button"
                  class="kontak-page-copy"
                  data-copy={nomorRekening}
                  aria-label="Salin nomor rekening"
                >
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    set:html={icons.copy}
                  />
                  <span class="kontak-page-copy-text">Salin</span>
                </button>
              </div>
            </div>
          </li>
          <li class="kontak-page-item">
            <span class="kontak-page-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icons.nama} />
            </span>
            <div class="kontak-page-body">
              <span class="kontak-page-label">Atas Nama</span>
              <span class="kontak-page-value">PKBM Alfatihah</span>
            </div>
          </li>
          <li class="kontak-page-item">
            <span class="kontak-page-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icons.tunai} />
            </span>
            <div class="kontak-page-body">
              <span class="kontak-page-label">Alternatif Pembayaran</span>
              <span class="kontak-page-value">Tunai langsung di PKBM.</span>
            </div>
          </li>
          <li class="kontak-page-item">
            <span class="kontak-page-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icons.luarNegeri} />
            </span>
            <div class="kontak-page-body">
              <span class="kontak-page-label">Transfer Luar Negeri</span>
              <span class="kontak-page-value">
                Transfer internasional (SWIFT) atau layanan transfer lintas
                negara ke rekening yang sama. Biaya transfer ditanggung
                pengirim.
              </span>
            </div>
          </li>
        </ul>
        <p class="kontak-page-note">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.info} />
          <span>Mohon konfirmasi ke CS sebelum transfer.</span>
        </p>
      </section>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".kontak-page-copy").forEach((btn) => {
    const label = btn.querySelector<HTMLElement>(".kontak-page-copy-text");
    let timer: number | undefined;

    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      if (label) label.textContent = "Tersalin";
      btn.classList.add("is-copied");
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = "Salin";
        btn.classList.remove("is-copied");
      }, 2000);
    });
  });
</script>