---
import "../styles/program/ModulCerdas.css";
---

<section
  class="modul-cerdas"
  id="modul-cerdas"
  aria-labelledby="modul-cerdas-title"
>
  <div class="modul-cerdas-container">

    <!-- HEADING -->
    <header class="modul-cerdas-heading">

      <span class="modul-cerdas-badge">
        Taman Baca
      </span>

      <h1 id="modul-cerdas-title">
        Modul Cerdas
      </h1>

      <span
        class="modul-cerdas-divider"
        aria-hidden="true"
      ></span>

      <p>
        Temukan berbagai modul pembelajaran untuk mendukung
        proses belajar yang lebih mudah dan menyenangkan.
      </p>

    </header>

    <!-- EMPTY STATE -->
    <div class="modul-cerdas-empty">

      <!-- ILUSTRASI BUKU -->
      <div class="modul-cerdas-illustration" aria-hidden="true">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 240 165"
          fill="none"
        >
          <!-- BAYANGAN -->
          <ellipse
            cx="120"
            cy="147"
            rx="89"
            ry="10"
            fill="#F3E3EE"
          />

          <!-- BACKGROUND -->
          <circle
            cx="120"
            cy="76"
            r="66"
            fill="#FBE6F3"
          />

          <!-- BUKU BAWAH UNGU -->
          <rect
            x="58"
            y="106"
            width="128"
            height="23"
            rx="6"
            fill="#A74E92"
          />

          <rect
            x="65"
            y="110"
            width="115"
            height="15"
            rx="3"
            fill="#FFF9F5"
          />

          <!-- BUKU KUNING -->
          <rect
            x="48"
            y="85"
            width="130"
            height="22"
            rx="6"
            fill="#FCD757"
          />

          <rect
            x="54"
            y="89"
            width="118"
            height="14"
            rx="3"
            fill="#FFFDF4"
          />

          <!-- COVER BUKU TERBUKA -->
          <path
            d="M120 83 Q85 57 43 69 L43 24 Q85 15 120 43 Q155 15 197 24 L197 69 Q155 57 120 83Z"
            fill="#A74E92"
            stroke="#92197B"
            stroke-width="3"
          />

          <!-- HALAMAN BUKU -->
          <path
            d="M120 76 Q85 52 49 62 L49 19 Q85 12 120 37 Q155 12 191 19 L191 62 Q155 52 120 76Z"
            fill="#FFFFFF"
          />

          <path
            d="M120 37V76"
            stroke="#D8B3D0"
            stroke-width="2"
          />

          <!-- GARIS HALAMAN KIRI -->
          <path
            d="M59 30 Q85 26 109 40
               M59 40 Q85 36 109 50
               M59 50 Q85 46 109 60"
            stroke="#D8B3D0"
            stroke-width="2"
            stroke-linecap="round"
          />

          <!-- GARIS HALAMAN KANAN -->
          <path
            d="M131 40 Q155 26 181 30
               M131 50 Q155 36 181 40
               M131 60 Q155 46 181 50"
            stroke="#D8B3D0"
            stroke-width="2"
            stroke-linecap="round"
          />

          <!-- SPARKLE -->
          <path
            d="M25 43L29 54L40 58L29 62L25 73L21 62L10 58L21 54Z"
            fill="#FCD757"
          />

          <path
            d="M211 76L215 87L226 91L215 95L211 106L207 95L196 91L207 87Z"
            fill="#FCD757"
          />

          <circle
            cx="208"
            cy="29"
            r="4"
            fill="#A74E92"
          />

          <circle
            cx="31"
            cy="112"
            r="4"
            fill="#A74E92"
          />
        </svg>

      </div>

      <!-- INFORMASI -->
      <h2>
        Modul Pembelajaran Segera Hadir
      </h2>

      <p>
        Saat ini belum ada modul pembelajaran yang tersedia.
        Sambil menunggu, yuk eksplorasi berbagai artikel edukatif
        di Formula Belajar Cerdas!
      </p>

      <!-- TOMBOL -->
      <a
        href="/formula-belajar-cerdas"
        class="modul-cerdas-button"
      >
        Jelajahi Artikel Belajar

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>

    </div>

  </div>
</section>