
---
import "../styles/program/CaraBelajarDiaspora.css";

const pilihanKelas = [
  {
    nama: "Private · 1 murid",
    deskripsi: "Pendampingan satu lawan satu, paling personal.",
  },
  {
    nama: "Semi Private · 4–6 murid",
    deskripsi: "Kelas kecil, tetap mendapat perhatian individual.",
  },
  {
    nama: "Reguler · lebih dari 15 murid",
    deskripsi: "Kelas besar, cocok untuk komunitas atau kelompok diaspora.",
  },
];
---

<section
  class="cara-belajar-diaspora"
  id="cara-belajar-diaspora"
  aria-labelledby="cara-belajar-diaspora-title"
>
  <div class="cara-belajar-diaspora-container">

    <!-- JUDUL SECTION -->
    <header class="cara-belajar-diaspora-heading">
      <h2 id="cara-belajar-diaspora-title">
        Pilih cara belajar yang paling pas
      </h2>

      <span
        class="cara-belajar-diaspora-divider"
        aria-hidden="true"
      ></span>
    </header>

    <!-- LAYOUT UTAMA -->
    <div class="cara-belajar-diaspora-layout">

      <!-- PANEL KIRI: ONLINE PRIVATE -->
      <article class="cara-belajar-diaspora-main">
        <div
          class="cara-belajar-diaspora-main-icon"
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="13" rx="2" />
            <path d="M8 21h8" />
            <path d="M12 17v4" />
            <path d="m10 8 5 2.5-5 2.5V8Z" />
          </svg>
        </div>

        <h3>Online Private</h3>

        <p class="cara-belajar-diaspora-main-description">
          Sesi daring, jadwal fleksibel lintas zona waktu.
        </p>

        <div class="cara-belajar-diaspora-main-duration">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>

          <span>Durasi 60 menit per pertemuan.</span>
        </div>
      </article>

      <!-- PANEL KANAN: PILIHAN KELAS -->
      <div class="cara-belajar-diaspora-classes">
        <h3>Pilihan kelas</h3>

        <div class="cara-belajar-diaspora-class-list">
          {pilihanKelas.map((kelas) => (
            <article class="cara-belajar-diaspora-class">
              <h4>{kelas.nama}</h4>
              <p>{kelas.deskripsi}</p>
            </article>
          ))}
        </div>
      </div>

    </div>

    <!-- INFORMASI KELAS REGULER -->
    <div class="cara-belajar-diaspora-note">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3a15 15 0 0 1 0 18" />
        <path d="M12 3a15 15 0 0 0 0 18" />
      </svg>

      <p>
        Kelas Reguler dapat diisi komunitas WNI di satu negara/kota,
        atau gabungan beberapa negara dengan zona waktu berdekatan.
      </p>
    </div>

  </div>
</section>
