---
import "../styles/program/CaraBelajarDiaspora.css";

const pilihanKelas = [
  {
    nama: "Private · 1 murid",
    deskripsi: "Pendampingan satu lawan satu, paling personal.",
  },
  {
    nama: "Semi Private · 4–6 murid",
    deskripsi: "Kelas kecil, tetap mendapat perhatian individual.",
  },
  {
    nama: "Reguler · lebih dari 15 murid",
    deskripsi: "Kelas besar, cocok untuk komunitas atau kelompok diaspora.",
  },
];
---

<section
  class="cara-belajar-diaspora"
  id="cara-belajar-diaspora"
  aria-labelledby="cara-belajar-diaspora-title"
>
  <div class="cara-belajar-diaspora-container">

    <!-- JUDUL SECTION -->
    <header class="cara-belajar-diaspora-heading">
      <h2 id="cara-belajar-diaspora-title">
        Pilih cara belajar yang paling pas
      </h2>

      <span
        class="cara-belajar-diaspora-divider"
        aria-hidden="true"
      ></span>
    </header>

    <!-- LAYOUT UTAMA -->
    <div class="cara-belajar-diaspora-layout">

      <!-- PANEL KIRI -->
      <article class="cara-belajar-diaspora-main">

        <div class="cara-belajar-diaspora-main-content">

          <!-- ILUSTRASI LAPTOP -->
          <div
            class="cara-belajar-diaspora-main-icon"
            aria-hidden="true"
          >
            <svg viewBox="0 0 180 150" fill="none">
              <defs>
                <linearGradient
                  id="diasporaLaptopScreen"
                  x1="35" y1="10"
                  x2="135" y2="110"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop stop-color="#1C3F72" />
                  <stop offset="1" stop-color="#001C49" />
                </linearGradient>

                <linearGradient
                  id="diasporaLaptopBody"
                  x1="90" y1="95"
                  x2="90" y2="140"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop stop-color="#FFFFFF" />
                  <stop offset="1" stop-color="#12376B" />
                </linearGradient>

                <linearGradient
                  id="diasporaLaptopPlay"
                  x1="76" y1="40"
                  x2="105" y2="82"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop stop-color="#F5D177" />
                  <stop offset="1" stop-color="#D9A035" />
                </linearGradient>
              </defs>

              <ellipse
                cx="90" cy="137"
                rx="78" ry="9"
                fill="#000000"
                opacity=".16"
              />

              <rect
                x="28" y="12"
                width="124" height="91"
                rx="9"
                fill="#D9E0EC"
              />

              <rect
                x="33" y="17"
                width="114" height="81"
                rx="5"
                fill="#001C49"
              />

              <rect
                x="39" y="23"
                width="102" height="69"
                rx="3"
                fill="url(#diasporaLaptopScreen)"
              />

              <path
                d="M78 43Q75 41 75 46V75Q75 80 80 77L107 61Q111 58 106 55Z"
                fill="url(#diasporaLaptopPlay)"
              />

              <path
                d="M28 103H152L174 129Q177 135 168 137H12Q3 135 7 129Z"
                fill="url(#diasporaLaptopBody)"
              />

              <path
                d="M36 108H144L157 122H23Z"
                fill="#001C49"
              />

              <g stroke="#12376B" stroke-width="1.5">
                <path d="M32 113H148" />
                <path d="M27 118H153" />
                <path d="M50 108L46 122" />
                <path d="M67 108L65 122" />
                <path d="M84 108V122" />
                <path d="M101 108L103 122" />
                <path d="M118 108L122 122" />
                <path d="M135 108L141 122" />
              </g>

              <rect
                x="72" y="126"
                width="36" height="6"
                rx="2"
                fill="#12376B"
              />
            </svg>
          </div>

          <!-- TEKS ONLINE PRIVATE -->
          <div class="cara-belajar-diaspora-main-text">
            <h3>Online Private</h3>

            <p class="cara-belajar-diaspora-main-description">
              Sesi daring, jadwal fleksibel lintas zona waktu.
            </p>
          </div>

        </div>

        <!-- DURASI -->
        <div class="cara-belajar-diaspora-main-duration">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>

          <span>Durasi 60 menit per pertemuan.</span>
        </div>

      </article>

      <!-- PANEL KANAN -->
      <div class="cara-belajar-diaspora-classes">

        <h3>Pilihan kelas</h3>

        <div class="cara-belajar-diaspora-class-list">

          {pilihanKelas.map((kelas, index) => (
            <article class="cara-belajar-diaspora-class">

              <!-- IKON KELAS -->
              <div
                class="cara-belajar-diaspora-class-icon"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  {index === 0 ? (
                    <>
                      <circle cx="16" cy="9" r="5" />
                      <path d="M6 27v-3a10 10 0 0 1 20 0v3Z" />
                    </>
                  ) : (
                    <>
                      <circle cx="12" cy="9" r="4.5" />
                      <path d="M3 26v-3a9 9 0 0 1 18 0v3Z" />

                      <path d="M21 5a4.5 4.5 0 0 1 0 9" />
                      <path d="M24 18a8 8 0 0 1 5 8" />

                      {index === 2 && (
                        <path d="M27 7a4 4 0 0 1 0 7" />
                      )}
                    </>
                  )}
                </svg>
              </div>

              <div class="cara-belajar-diaspora-class-content">
                <h4>{kelas.nama}</h4>
                <p>{kelas.deskripsi}</p>
              </div>

            </article>
          ))}

        </div>
      </div>

    </div>

    <!-- INFORMASI KELAS REGULER -->
    <div class="cara-belajar-diaspora-note">

      <svg
        viewBox="0 0 32 32"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="9" r="4.5" />
        <path d="M3 26v-3a9 9 0 0 1 18 0v3Z" />
        <path d="M21 5a4.5 4.5 0 0 1 0 9" />
        <path d="M24 18a8 8 0 0 1 5 8" />
      </svg>

      <p>
        Kelas Reguler dapat diisi komunitas WNI di satu negara/kota,
        atau gabungan beberapa negara dengan zona waktu berdekatan.
      </p>

    </div>

  </div>

  <!-- GELOMBANG BAWAH -->
  <svg
    class="cara-belajar-diaspora-wave"
    viewBox="0 0 1440 100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M0 40
         C180 95 300 95 480 55
         C660 15 800 25 960 58
         C1140 95 1300 80 1440 30
         V100 H0Z"
    />
  </svg>

</section>