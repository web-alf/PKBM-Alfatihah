---
import { Image } from "astro:assets";
import { formulaBelajar } from "../data/formula-belajar";
import "../styles/program/FormulaBelajarCerdas.css";
---

<section
  class="formula-belajar"
  id="formula-belajar-cerdas"
  aria-labelledby="formula-belajar-cerdas-title"
>
  <div class="formula-belajar-container">

    <!-- HEADING -->
    <header class="formula-belajar-heading">

      <span class="formula-belajar-badge">
        Formula Belajar Cerdas
      </span>

      <h1 id="formula-belajar-cerdas-title">
        Artikel & Inspirasi Belajar
      </h1>

      <span
        class="formula-belajar-divider"
        aria-hidden="true"
      ></span>

      <p>
        Temukan berbagai artikel edukatif, tips belajar, dan panduan
        praktis untuk meningkatkan kemampuan dan pengetahuanmu
        di berbagai bidang.
      </p>

    </header>

    <!-- GRID ARTIKEL -->
    <div class="formula-belajar-grid">

      {
        formulaBelajar.map((article) => (
          <article class="formula-article-card">

            <!-- GAMBAR -->
            <div class="formula-article-media">

              <a
                class="formula-article-image-link"
                href={`/formula-belajar-cerdas/${article.slug}`}
                aria-label={article.title}
              >
                <Image
                  src={article.image}
                  alt={article.title}
                  class="formula-article-image"
                  loading="lazy"
                />
              </a>

              <!-- KATEGORI -->
              <span class="formula-article-category">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 7v14" />
                  <path d="M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13h-5a4 4 0 0 0-4 3 4 4 0 0 0-4-3Z" />
                </svg>

                {article.topic}
              </span>

            </div>

            <!-- ISI CARD -->
            <div class="formula-article-body">

              <h2 class="formula-article-title">
                <a href={`/formula-belajar-cerdas/${article.slug}`}>
                  {article.title}
                </a>
              </h2>

              <p class="formula-article-excerpt">
                {article.excerpt}
              </p>

              <!-- FOOTER CARD -->
              <div class="formula-article-footer">

                <time
                  class="formula-article-date"
                  datetime={article.dateISO}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M16 3v4M8 3v4M3 10h18" />
                  </svg>

                  {article.date}
                </time>

                <a
                  class="formula-article-button"
                  href={`/formula-belajar-cerdas/${article.slug}`}
                >
                  Baca Selengkapnya

                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>

              </div>

            </div>

          </article>
        ))
      }

    </div>

  </div>
</section>