---
// Ilustrasi soft cartoon untuk header kartu Tujuan. viewBox 64x64. name: topi | buku | piala
const { name, class: className = "" } = Astro.props;
---

<svg
  class:list={["ikon-tujuan", className]}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  {name === "topi" && (
    <>
      <path d="M17 30V42C17 48 24 52 32 52C40 52 47 48 47 42V30Z" fill="#5E2A9E" />
      <path d="M17 30V36C20 40 26 42 32 42V30Z" fill="#7A3FC0" opacity="0.5" />
      <path d="M32 9L60 22L32 35L4 22Z" fill="#8E52D6" />
      <path d="M32 9L60 22L32 22Z" fill="#A877E6" />
      <path d="M32 22L52 31" stroke="#FFC400" stroke-width="2.6" stroke-linecap="round" />
      <circle cx="32" cy="22" r="3.4" fill="#FFC400" />
      <path d="M52 31V43" stroke="#FFC400" stroke-width="2.6" stroke-linecap="round" />
      <circle cx="52" cy="46" r="3.6" fill="#FFC400" />
    </>
  )}
  {name === "buku" && (
    <>
      <ellipse cx="32" cy="55" rx="25" ry="3.5" fill="#75194F" opacity="0.14" />
      <rect x="7" y="40" width="50" height="14" rx="7" fill="#7A3FC0" />
      <rect x="14" y="43" width="38" height="3" rx="1.5" fill="#B795E8" />
      <rect x="10" y="26" width="46" height="14" rx="7" fill="#FFC400" />
      <rect x="18" y="29" width="32" height="3" rx="1.5" fill="#FFE590" />
      <rect x="8" y="12" width="48" height="14" rx="7" fill="#E8508F" />
      <rect x="16" y="15" width="34" height="3" rx="1.5" fill="#F5A0C4" />
    </>
  )}
  {name === "piala" && (
    <>
      <path d="M17 14C8 14 6 28 20 32" fill="none" stroke="#E5A800" stroke-width="4.5" stroke-linecap="round" />
      <path d="M47 14C56 14 58 28 44 32" fill="none" stroke="#E5A800" stroke-width="4.5" stroke-linecap="round" />
      <path d="M16 8H48V22C48 32 41 38 32 38C23 38 16 32 16 22Z" fill="#FFC400" />
      <path d="M16 8H27V37C21 35 16 29 16 22Z" fill="#FFDD6B" opacity="0.7" />
      <path d="M32 14L34.4 19L40 19.8L36 23.6L37 29L32 26.4L27 29L28 23.6L24 19.8L29.6 19Z" fill="#E8508F" />
      <rect x="28" y="37" width="8" height="9" fill="#E5A800" />
      <rect x="19" y="46" width="26" height="9" rx="4.5" fill="#E8508F" />
      <rect x="23" y="48.5" width="18" height="2.4" rx="1.2" fill="#F5A0C4" />
    </>
  )}
</svg>