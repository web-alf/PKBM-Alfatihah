
---
import "../styles/program/CaraDaftarHomeschooling.css";

const langkahPendaftaran = [
  {
    nomor: "1",
    judul: "Hubungi Kami",
    deskripsi: "Isi formulir di website atau hubungi WhatsApp pendaftaran.",
  },
  {
    nomor: "2",
    judul: "Persiapan Tutor",
    deskripsi:
      "Tim menyiapkan tutor dan sistem KBM (estimasi 5 jam – 3 hari kerja).",
  },
  {
    nomor: "3",
    judul: "Sesi Perdana",
    deskripsi:
      "Tutor menghubungi peserta, menyepakati jadwal, dan belajar dimulai.",
  },
];

const linkFormulir = "/pendaftaran";
---

<section
  class="cara-daftar-hs"
  id="cara-mendaftar"
  aria-labelledby="cara-daftar-hs-title"
>
  <div class="cara-daftar-hs-container">

    <!-- JUDUL SECTION -->
    <div class="cara-daftar-hs-heading">
      <h2 id="cara-daftar-hs-title">
        Bagaimana Cara Mendaftar?
      </h2>

      <span
        class="cara-daftar-hs-underline"
        aria-hidden="true"
      ></span>

      <p>Mudah, cukup ikuti langkah berikut.</p>
    </div>

    <!-- ALUR PENDAFTARAN -->
    <div class="cara-daftar-hs-steps">
      {langkahPendaftaran.map((langkah) => (
        <article class="cara-daftar-hs-step">

          <!-- LINGKARAN NOMOR -->
          <div class="cara-daftar-hs-number-wrap">
            <span class="cara-daftar-hs-number">
              {langkah.nomor}
            </span>
          </div>

          <!-- CARD INFORMASI -->
          <div class="cara-daftar-hs-card">

            <!-- IKON -->
            <div
              class="cara-daftar-hs-icon"
              aria-hidden="true"
            >
              {langkah.nomor === "1" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <defs>
                    <linearGradient id="hs-phone-gradient"
                      x1="3" y1="2" x2="21" y2="21"
                      gradientUnits="userSpaceOnUse">
                      <stop stop-color="#B71996" />
                      <stop offset="1" stop-color="#6B1259" />
                    </linearGradient>
                  </defs>

                  <ellipse cx="12" cy="22.5" rx="8" ry="1.2"
                    fill="#92197B" opacity=".12" />

                  <path
                    d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"
                    fill="url(#hs-phone-gradient)"
                    stroke="#6B1259"
                    stroke-width="0.6"
                  />
                  <path
                    d="M14.5 3.5c3 .7 5.3 3 6 6"
                    stroke="#FCD757"
                    stroke-width="1.3"
                    stroke-linecap="round"
                  />
                </svg>
              )}

              {langkah.nomor === "2" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <defs>
                    <linearGradient id="hs-doc-gradient"
                      x1="6" y1="2" x2="22" y2="22"
                      gradientUnits="userSpaceOnUse">
                      <stop stop-color="#B71996" />
                      <stop offset="1" stop-color="#6B1259" />
                    </linearGradient>
                  </defs>

                  <ellipse cx="12" cy="22.5" rx="8" ry="1.2"
                    fill="#92197B" opacity=".12" />

                  <path
                    d="M8 3h9l4 4v14H8z"
                    fill="url(#hs-doc-gradient)"
                    stroke="#6B1259"
                    stroke-width="0.6"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M17 3v5h4"
                    fill="#FFFFFF"
                    opacity=".3"
                    stroke="#FFFFFF"
                    stroke-width="0.6"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M4 5v16"
                    stroke="#FCD757"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    opacity=".8"
                  />
                  <path
                    d="M11 11h7M11 14h7M11 17h5"
                    stroke="#FCD757"
                    stroke-width="1.3"
                    stroke-linecap="round"
                  />
                </svg>
              )}

              {langkah.nomor === "3" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <defs>
                    <linearGradient id="hs-rocket-gradient"
                      x1="5" y1="2" x2="22" y2="20"
                      gradientUnits="userSpaceOnUse">
                      <stop stop-color="#B71996" />
                      <stop offset="1" stop-color="#6B1259" />
                    </linearGradient>
                  </defs>

                  <ellipse cx="12" cy="22.5" rx="8" ry="1.2"
                    fill="#92197B" opacity=".12" />

                  <path
                    d="M21.5 2.5c-5.3-.3-9.5 1.8-12.6 6.1L5 9l-3 5 5.5.5 2 2L10 22l5-3 .4-3.9c4.3-3.1 6.4-7.3 6.1-12.6Z"
                    fill="url(#hs-rocket-gradient)"
                    stroke="#6B1259"
                    stroke-width="0.6"
                    stroke-linejoin="round"
                  />
                  <circle
                    cx="16" cy="8" r="2"
                    fill="#FFFFFF"
                    stroke="#FCD757"
                    stroke-width="0.6"
                  />
                  <path
                    d="M6 17c-2.5.5-3.5 2.5-4 5 2.5-.5 4.5-1.5 5-4Z"
                    fill="#FCD757"
                    opacity=".85"
                  />
                </svg>
              )}
            </div>

            <h3>{langkah.judul}</h3>

            {langkah.nomor === "1" ? (
              <p>
                Isi formulir di website (
                <a
                  href={linkFormulir}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cara-daftar-hs-text-link"
                >
                  Formulir Pendaftaran PKBM
                </a>
                ) atau hubungi WhatsApp pendaftaran.
              </p>
            ) : (
              <p>{langkah.deskripsi}</p>
            )}
          </div>

        </article>
      ))}
    </div>

    <!-- CATATAN TAMBAHAN -->
    <div class="cara-daftar-hs-note">
      <p>
        Jadwal, teknis pembelajaran, dan rincian biaya
        dikomunikasikan kepada Ayah/Bunda sebelum program dimulai.
      </p>
    </div>

  </div>

  <!-- GELOMBANG BAWAH MENUJU FAQ -->
  <svg
    class="cara-daftar-hs-wave"
    viewBox="0 0 1440 100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M0 36
         C180 92 320 90 500 48
         C680 6 810 30 980 62
         C1160 96 1300 12 1440 20
         V100 H0 Z"
    />
  </svg>

</section>
