
---
import "../styles/program/FAQSmartLearning.css";

const daftarFAQ = [
  {
    pertanyaan: "Berapa lama satu kali pertemuan?",
    jawaban: "60 menit per pertemuan.",
  },
  {
    pertanyaan: "Apakah bisa belajar online?",
    jawaban:
      "Bisa! Pilih Online Private. Harga kelas online lebih hemat dibanding offline.",
  },
  {
    pertanyaan: "Apakah tutor bisa datang ke rumah?",
    jawaban:
      "Bisa, dengan Home Private. Ada tambahan Rp15.000 per pertemuan.",
  },
  {
    pertanyaan: "Untuk usia berapa saja?",
    jawaban:
      "Academic untuk SD–SMA, Tahfidz untuk semua jenjang, Tahsin cocok untuk pemula, sedangkan English dan AI untuk segala usia.",
  },
  {
    pertanyaan: "Berapa biaya lesnya?",
    jawaban:
      "Mulai Rp25.000 per pertemuan, tergantung pilar, mode belajar, dan kelas. Lihat tabel harga di Bagian 5.",
  },
  {
    pertanyaan: "Berapa biaya pendaftarannya?",
    jawaban:
      "Rp150.000 (diskon 50% dari harga normal Rp300.000), berlaku untuk semua kelas dan pilar, sampai kuota terpenuhi.",
  },
  {
    pertanyaan: "Kalau mau ambil dua pilar sekaligus?",
    jawaban:
      "Ada diskon Paket 2 Pilar, misalnya Tahfidz + Academic atau English + AI.",
  },
  {
    pertanyaan: "Bagaimana cara membayar?",
    jawaban:
      "Transfer Bank BSI No. Rek. 7266356026 a.n. PKBM Alfatihah, atau tunai langsung di PKBM. Mohon konfirmasi ke CS sebelum transfer.",
  },
];

// Memisahkan FAQ menjadi dua kolom independen
const faqKiri = daftarFAQ.filter(
  (_, index) => index % 2 === 0
);

const faqKanan = daftarFAQ.filter(
  (_, index) => index % 2 !== 0
);
---

<section
  class="faq-smart"
  id="faq-smart-learning"
  aria-labelledby="faq-smart-title"
>
  <div class="faq-smart-container">

    <!-- JUDUL SECTION -->
    <header class="faq-smart-heading">
      <h2 id="faq-smart-title">
        Pertanyaan yang Sering Diajukan
      </h2>

      <span
        class="faq-smart-divider"
        aria-hidden="true"
      ></span>

      <p>
        Temukan jawaban atas pertanyaan umum seputar
        program Alfatihah Smart Learning.
      </p>
    </header>

    <!-- DAFTAR FAQ -->
    <div class="faq-smart-list">

      <!-- KOLOM KIRI -->
      <div class="faq-smart-column">

        {faqKiri.map((faq) => (
          <details
            class="faq-smart-item"
            name="faq-smart-accordion"
          >
            <summary class="faq-smart-question">

              <span>{faq.pertanyaan}</span>

              <span
                class="faq-smart-icon"
                aria-hidden="true"
              ></span>

            </summary>

            <div class="faq-smart-answer">
              <p>{faq.jawaban}</p>
            </div>

          </details>
        ))}

      </div>

      <!-- KOLOM KANAN -->
      <div class="faq-smart-column">

        {faqKanan.map((faq) => (
          <details
            class="faq-smart-item"
            name="faq-smart-accordion"
          >
            <summary class="faq-smart-question">

              <span>{faq.pertanyaan}</span>

              <span
                class="faq-smart-icon"
                aria-hidden="true"
              ></span>

            </summary>

            <div class="faq-smart-answer">
              <p>{faq.jawaban}</p>
            </div>

          </details>
        ))}

      </div>

    </div>

  </div>

  <!-- GELOMBANG MENUJU FOOTER -->
  <svg
    class="faq-smart-wave"
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="
        M0 30
        C120 5 240 90 360 75
        C480 60 500 20 600 45
        C700 70 740 95 840 65
        C950 35 1000 15 1110 45
        C1240 85 1320 65 1440 25
        V120
        H0
        Z
      "
    />
  </svg>

</section>
