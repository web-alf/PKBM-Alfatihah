---
import "../styles/program/FAQHomeschooling.css";

const daftarFAQ = [
  {
    pertanyaan: "Apakah homeschooling di PKBM Al-Fatihah resmi?",
    jawaban:
      "Ya. Alfatihah Homeschooling adalah layanan pendidikan alternatif resmi, terakreditasi A, menggunakan Kurikulum Nasional yang disetarakan dengan pendidikan formal.",
  },
  {
    pertanyaan: "Berapa kali belajar dalam seminggu?",
    jawaban:
      "Kelas Online, Siswa ke Lembaga, dan Tutor ke Rumah berlangsung 3 kali per minggu. Jadwal disepakati bersama sesuai ketersediaan tutor dan peserta didik.",
  },
  {
    pertanyaan: "Kelas offline tersedia di wilayah mana?",
    jawaban:
      "Kelas Siswa ke Lembaga dan Tutor ke Rumah tersedia untuk wilayah Semarang Timur. Di luar wilayah tersebut, Ananda dapat memilih Kelas Online atau Mandiri.",
  },
  {
    pertanyaan: "Apa bedanya Kelas Mandiri dengan kelas lainnya?",
    jawaban:
      "Kelas Mandiri belajar dengan modul dan lembar kerja secara mandiri, didukung tutor sesuai program, dengan SPP paling hemat (Rp325.000/bulan).",
  },
  {
    pertanyaan: "Kapan biaya pendaftaran dibayarkan?",
    jawaban:
      "Biaya pendaftaran dibayar maksimal 1 hari setelah tutor mengajar. Biaya ujian dan kelulusan dibayarkan sesuai tahap pelaksanaannya.",
  },
  {
    pertanyaan: "Apakah biaya bisa berubah?",
    jawaban:
      "Biaya dapat berubah sewaktu-waktu sesuai kebijakan PKBM Al-Fatihah. Rincian biaya selalu dikomunikasikan kepada Ayah/Bunda sebelum program dimulai.",
  },
];
---

<section
  class="faq-homeschooling"
  aria-labelledby="faq-homeschooling-title"
>
  <div class="faq-homeschooling-container">
    <header class="faq-homeschooling-heading">
      <h2 id="faq-homeschooling-title">
        Pertanyaan yang Sering Diajukan
      </h2>

      <span class="faq-homeschooling-line" aria-hidden="true"></span>

      <p>
        Temukan jawaban atas pertanyaan umum seputar program Homeschooling PKBM Al-Fatihah.
      </p>
    </header>

    <div class="faq-homeschooling-list">
      {daftarFAQ.map((item, index) => {
        const questionId = `faq-homeschooling-question-${index + 1}`;
        const answerId = `faq-homeschooling-answer-${index + 1}`;
        const isOpen = index === 0;

        return (
          <article class="faq-homeschooling-item">
            <h3 class="faq-homeschooling-question-heading">
              <button
                id={questionId}
                class="faq-homeschooling-question"
                type="button"
                aria-expanded={isOpen ? "true" : "false"}
                aria-controls={answerId}
              >
                <span>{item.pertanyaan}</span>

                <span class="faq-homeschooling-icon" aria-hidden="true">
                  <span class="faq-homeschooling-plus">+</span>
                  <span class="faq-homeschooling-minus">−</span>
                </span>
              </button>
            </h3>

            <div
              id={answerId}
              class:list={[
                "faq-homeschooling-answer",
                isOpen && "is-open",
              ]}
              role="region"
              aria-labelledby={questionId}
              aria-hidden={isOpen ? "false" : "true"}
              inert={!isOpen}
            >
              <div class="faq-homeschooling-answer-inner">
                <p>{item.jawaban}</p>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll(".faq-homeschooling").forEach((section) => {
    const buttons = Array.from(
      section.querySelectorAll(".faq-homeschooling-question"),
    );

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const shouldOpen = button.getAttribute("aria-expanded") !== "true";

        buttons.forEach((item) => {
          const isOpen = item === button && shouldOpen;
          const answerId = item.getAttribute("aria-controls");
          const answer = answerId
            ? section.querySelector(`#${answerId}`)
            : null;

          item.setAttribute("aria-expanded", String(isOpen));

          if (answer instanceof HTMLElement) {
            answer.classList.toggle("is-open", isOpen);
            answer.setAttribute("aria-hidden", String(!isOpen));
            answer.toggleAttribute("inert", !isOpen);
          }
        });
      });
    });
  });
</script>
