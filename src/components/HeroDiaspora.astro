
---
import "../styles/program/HeroDiaspora.css";
import diasporaLogo from "../assets/image/diaspora.webp";

const whatsappUrl = "https://wa.me/6285319485269";
---

<section
  class="hero-diaspora"
  id="diaspora-quran-center"
  aria-labelledby="hero-diaspora-title"
>
  <div class="hero-diaspora-container">

    <!-- LOGO PROGRAM -->
    <div class="hero-diaspora-logo">
      <img
        src={diasporaLogo.src}
        alt="Logo Diaspora Qur'an Center"
        width="168"
        height="84"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- LABEL KECIL -->
    <span class="hero-diaspora-label">
      UNTUK DIASPORA INDONESIA
    </span>

    <!-- JUDUL UTAMA -->
    <h1 id="hero-diaspora-title">
      <span class="hero-diaspora-title-white">Diaspora</span>{" "}
      <span class="hero-diaspora-title-gold">Qur'an Center</span>
    </h1>

    <!-- GARIS EMAS -->
    <span
      class="hero-diaspora-divider"
      aria-hidden="true"
    ></span>

    <!-- DESKRIPSI -->
    <p class="hero-diaspora-description">
      Diaspora Qur'an Center adalah layanan les privat Tahsin
      dan Tahfidz Al-Qur'an secara daring untuk anak-anak dan
      keluarga Indonesia di luar negeri, diselenggarakan oleh
      PKBM Alfatihah Semarang. Belajar dari mana saja, dengan
      bahasa Indonesia dan jadwal yang menyesuaikan zona
      waktu peserta.
    </p>

    <!-- TAGLINE -->
    <p class="hero-diaspora-tagline">
      Personalized Qur'an Learning
      <span aria-hidden="true">•</span>
      Islamic Values
      <span aria-hidden="true">•</span>
      Anywhere in the World
    </p>

    <!-- BADGE PROMO -->
    <div class="hero-diaspora-promo">

      <div class="hero-diaspora-promo-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V4a1 1 0 0 1 1-1h8a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.8Z"
          />
          <circle cx="7.5" cy="7.5" r="1.2" />
        </svg>
      </div>

      <div class="hero-diaspora-promo-content">

        <span class="hero-diaspora-promo-badge">
          Diskon pendaftaran 50%
        </span>

        <div class="hero-diaspora-promo-prices">
          <strong>Rp150.000</strong>

          <span>
            normal <s>Rp300.000</s>
          </span>
        </div>

      </div>
    </div>

    <!-- TOMBOL CTA -->
    <div class="hero-diaspora-actions">

      <a
        href={whatsappUrl}
        class="hero-diaspora-btn hero-diaspora-btn-primary"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.6A8.5 8.5 0 1 1 21 11.5Z"
          />
          <path d="M8.5 9.5c1 2.5 3 4.5 5.5 5.5" />
        </svg>

        Konsultasi via WhatsApp
      </a>

      <a
        href="#harga-diaspora"
        class="hero-diaspora-btn hero-diaspora-btn-secondary"
      >
        Lihat Harga
        <span aria-hidden="true">↓</span>
      </a>

    </div>

  </div>
</section>
