---
import logoPKBM from "../assets/image/PKBM_icon.webp";
import "../styles/FooterPKBM.css";

const whatsappUrl = "https://wa.me/6285319485269";
const whatsappLabel = "+62 853-1948-5269";
const email = "alfatihahhomeschooling@gmail.com";
const alamat = "PKBM Alfatihah Semarang, Jawa Tengah";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navigasi = [
  { name: "Beranda", href: "/" },
  { name: "Tentang Kami", href: "/tentang-kami" },
  { name: "Program", href: "/#program-kami" },
  { name: "Kontak", href: "/kontak" },
];

const programs = [
  { name: "Kejar Paket A, B & C", href: "/program-kesetaraan" },
  { name: "Alfatihah Homeschooling", href: "/homeschooling" },
  { name: "Alfatihah Smart Learning", href: "/smart-learning" },
  { name: "Diaspora Qur\u2019an Center", href: "/diaspora" },
];

const chevronPath = "M9 6l6 6-6 6";
---

<footer class="footer-pkbm">
  <div class="footer-pkbm-container">
    <div class="footer-pkbm-grid">
      <div class="footer-pkbm-col footer-pkbm-brand">
        <a href="/" class="footer-pkbm-logo" aria-label="PKBM Alfatihah - Beranda">
          <img
            src={logoPKBM.src}
            alt="PKBM Alfatihah"
            width="200"
            height="65"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p>
          Solusi Pendidikan Fleksibel, Kredibel &amp; Islami. PKBM Alfatihah
          adalah tempat belajar untuk semua orang, tanpa memandang usia atau
          latar belakang.
        </p>
      </div>

      <nav class="footer-pkbm-col" aria-labelledby="footer-nav-title">
        <h2 id="footer-nav-title">Navigasi</h2>
        <ul class="footer-pkbm-links">
          {navigasi.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.href === currentPath ? "page" : undefined}
              >
                <svg class="footer-pkbm-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={chevronPath} /></svg>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="footer-pkbm-col" aria-labelledby="footer-program-title">
        <h2 id="footer-program-title">Program</h2>
        <ul class="footer-pkbm-links">
          {programs.map((program) => (
            <li>
              <a href={program.href}>
                <svg class="footer-pkbm-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={chevronPath} /></svg>
                {program.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-pkbm-col footer-pkbm-contact">
        <h2>Kontak</h2>
        <ul class="footer-pkbm-info">
          <li>
            <svg class="footer-pkbm-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5z" /><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1.5-1.8-2.3-1.2-1 .8c-1-.4-1.9-1.3-2.3-2.3l.8-1L10.9 7 9 8.5z" /></svg>
            <span class="footer-pkbm-sr">WhatsApp CS:</span>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{whatsappLabel}</a>
          </li>
          <li>
            <svg class="footer-pkbm-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M4 7.5l8 6 8-6" /></svg>
            <span class="footer-pkbm-sr">Email:</span>
            <a href={`mailto:${email}`}>{email}</a>
          </li>
          <li>
            <svg class="footer-pkbm-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.1 7-11.5a7 7 0 0 0-14 0C5 14.9 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
            <span class="footer-pkbm-sr">Alamat:</span>
            <span>{alamat}</span>
          </li>
        </ul>
        <a href="/kontak" class="footer-pkbm-more">
          Lihat Informasi Selengkapnya
          <svg class="footer-pkbm-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={chevronPath} /></svg>
        </a>
      </div>
    </div>

    <p class="footer-pkbm-text">
      <span>&copy; 2026 PKBM Alfatihah. All Rights Reserved.</span>
      <span class="footer-pkbm-separator" aria-hidden="true"></span>
      <span>Pusat Kegiatan Belajar Masyarakat</span>
      <span class="footer-pkbm-separator" aria-hidden="true"></span>
      <span>Terakreditasi A</span>
    </p>
  </div>
</footer>