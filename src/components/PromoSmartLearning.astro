---
import "../styles/program/PromoSmartLearning.css";

const whatsappUrl = "https://wa.me/6285319485269";
---

<section
  class="promo-smart"
  id="promo-smart-learning"
  aria-labelledby="promo-smart-title"
>
  <div class="promo-smart-container">

    <!-- JUDUL SECTION -->
    <header class="promo-smart-heading">
      <h2 id="promo-smart-title">
        Promo & Diskon
      </h2>

      <span
        class="promo-smart-divider"
        aria-hidden="true"
      ></span>
    </header>

    <!-- PROMO UTAMA -->
    <div class="promo-smart-main">

      <!-- ILUSTRASI MEGAFON -->
      <div
        class="promo-smart-megaphone"
        aria-hidden="true"
      >
        <svg viewBox="0 0 200 180" fill="none">

          <defs>
            <linearGradient id="promo-mega-body" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#B98FDD" />
              <stop offset=".45" stop-color="#7E55B3" />
              <stop offset="1" stop-color="#3C1E66" />
            </linearGradient>

            <linearGradient id="promo-mega-white" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#FFFFFF" />
              <stop offset=".6" stop-color="#FFF7E5" />
              <stop offset="1" stop-color="#E8D9A8" />
            </linearGradient>

            <linearGradient id="promo-mega-gold" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#FFF4C2" />
              <stop offset=".5" stop-color="#FCD757" />
              <stop offset="1" stop-color="#D9A035" />
            </linearGradient>

            <linearGradient id="promo-mega-inner" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#FFF9DA" />
              <stop offset="1" stop-color="#E4B94E" />
            </linearGradient>
          </defs>

          <ellipse
            cx="86" cy="165"
            rx="53" ry="7"
            fill="#3C1E66"
            opacity=".18"
          />

          <g transform="rotate(-24 92 90)">

            <!-- Pegangan -->
            <rect
              x="59" y="107"
              width="27" height="49"
              rx="9"
              fill="url(#promo-mega-gold)"
              stroke="#D9A035"
              stroke-width="1.5"
            />

            <rect
              x="64" y="115"
              width="8" height="30"
              rx="4"
              fill="#FFF4C2"
              opacity=".7"
            />

            <!-- Bagian belakang -->
            <rect
              x="20" y="65"
              width="52" height="48"
              rx="22"
              fill="url(#promo-mega-body)"
              stroke="#3C1E66"
              stroke-width="2"
            />

            <path
              d="M29 76Q34 69 45 70"
              stroke="#D8C2EE"
              stroke-width="4"
              stroke-linecap="round"
              opacity=".8"
            />

            <!-- Corong megafon -->
            <path
              d="M53 65L127 30V145L53 113Q44 89 53 65Z"
              fill="url(#promo-mega-white)"
              stroke="#D9C9E6"
              stroke-width="1.5"
            />

            <!-- Bagian depan corong -->
            <ellipse
              cx="128" cy="87"
              rx="28" ry="59"
              fill="url(#promo-mega-gold)"
              stroke="#D9A035"
              stroke-width="2"
            />

            <ellipse
              cx="128" cy="87"
              rx="21" ry="49"
              fill="url(#promo-mega-inner)"
            />

            <ellipse
              cx="120" cy="87"
              rx="10" ry="23"
              fill="#E7AD37"
            />

            <ellipse
              cx="127" cy="87"
              rx="9" ry="16"
              fill="#FCD757"
            />

            <path
              d="M121 44Q109 59 109 76"
              stroke="#FFFCEB"
              stroke-width="4"
              stroke-linecap="round"
              opacity=".85"
            />

          </g>

          <!-- Efek suara -->
          <path
            d="M156 35L169 17
               M170 55L190 46
               M172 80L192 83"
            stroke="#D9A035"
            stroke-width="9"
            stroke-linecap="round"
          />

          <path
            d="M146 19L149 8"
            stroke="#FCD757"
            stroke-width="5"
            stroke-linecap="round"
          />

        </svg>
      </div>

      <!-- INFORMASI PROMO -->
      <div class="promo-smart-main-content">

        <span class="promo-smart-main-label">
          BIAYA PENDAFTARAN · DISKON 50%
        </span>

        <div class="promo-smart-prices">

          <s class="promo-smart-old-price">
            Rp300.000
          </s>

          <strong class="promo-smart-new-price">
            Rp150.000
          </strong>

        </div>

        <p class="promo-smart-main-description">
          Diskon 50% semua kelas & pilar.
        </p>

      </div>

      <!-- ILUSTRASI CONFETTI -->
      <div
        class="promo-smart-confetti"
        aria-hidden="true"
      >
        <svg viewBox="0 0 150 150" fill="none">

          <defs>
            <linearGradient id="promo-confetti-pink" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#B98FDD" />
              <stop offset=".5" stop-color="#7E55B3" />
              <stop offset="1" stop-color="#3C1E66" />
            </linearGradient>

            <linearGradient id="promo-confetti-gold" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#FFF4C2" />
              <stop offset="1" stop-color="#E7AD37" />
            </linearGradient>
          </defs>

          <!-- Pita atas -->
          <path
            d="M19 15C40-5 48 27 31 35C22 39 20 26 32 25"
            stroke="url(#promo-confetti-pink)"
            stroke-width="9"
            stroke-linecap="round"
          />

          <!-- Koin diskon -->
          <g transform="rotate(-18 68 55)">

            <circle
              cx="68" cy="59"
              r="22"
              fill="#2A1548"
            />

            <circle
              cx="68" cy="54"
              r="22"
              fill="url(#promo-confetti-pink)"
            />

            <circle
              cx="68" cy="54"
              r="15"
              fill="url(#promo-confetti-gold)"
              stroke="#FCD757"
              stroke-width="2"
            />

            <text
              x="68" y="61"
              text-anchor="middle"
              font-size="21"
              font-weight="800"
              font-family="Arial, sans-serif"
              fill="#3C1E66"
            >
              %
            </text>

          </g>

          <!-- Pita kanan -->
          <path
            d="M106 35Q133 46 111 62Q95 75 118 84"
            stroke="url(#promo-confetti-pink)"
            stroke-width="9"
            stroke-linecap="round"
          />

          <!-- Pita bawah -->
          <path
            d="M82 91L103 97L93 110L113 122"
            stroke="#D9A035"
            stroke-width="7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <!-- Potongan confetti -->
          <rect
            x="37" y="82"
            width="9" height="15"
            rx="2"
            fill="#FCD757"
            transform="rotate(35 37 82)"
          />

          <rect
            x="127" y="95"
            width="8" height="13"
            rx="2"
            fill="#8F6CC2"
            transform="rotate(-30 127 95)"
          />

          <path
            d="M61 108L65 116L74 118L67 124L68 133L61 129L53 133L55 124L48 118L57 116Z"
            fill="#FCD757"
          />

          <circle cx="94" cy="15" r="4" fill="#FCD757" />
          <circle cx="26" cy="65" r="4" fill="#8F6CC2" />

        </svg>
      </div>

    </div>

    <!-- DUA PROMO PENDAMPING -->
    <div class="promo-smart-grid">

      <!-- PAKET 2 PILAR -->
      <article class="promo-smart-card">

        <div class="promo-smart-icon" aria-hidden="true">

          <!-- ILUSTRASI KADO -->
          <svg viewBox="0 0 80 80" fill="none">

            <defs>
              <linearGradient id="promo-gift-body" x1="0" y1="0" x2="1" y2="1">
                <stop stop-color="#B98FDD" />
                <stop offset=".5" stop-color="#7E55B3" />
                <stop offset="1" stop-color="#3C1E66" />
              </linearGradient>

              <linearGradient id="promo-gift-gold" x1="0" y1="0" x2="1" y2="1">
                <stop stop-color="#FFF4C2" />
                <stop offset=".5" stop-color="#FCD757" />
                <stop offset="1" stop-color="#D9A035" />
              </linearGradient>
            </defs>

            <ellipse
              cx="40" cy="71"
              rx="27" ry="4"
              fill="#3C1E66"
              opacity=".12"
            />

            <!-- Kotak kado -->
            <rect
              x="13" y="31"
              width="54" height="38"
              rx="5"
              fill="url(#promo-gift-body)"
              stroke="#3C1E66"
              stroke-width="2"
            />

            <!-- Pita vertikal -->
            <rect
              x="34" y="30"
              width="12" height="39"
              fill="url(#promo-gift-gold)"
              stroke="#D9A035"
              stroke-width="1"
            />

            <!-- Tutup kado -->
            <rect
              x="8" y="23"
              width="64" height="14"
              rx="4"
              fill="url(#promo-gift-body)"
              stroke="#3C1E66"
              stroke-width="2"
            />

            <rect
              x="34" y="23"
              width="12" height="14"
              fill="url(#promo-gift-gold)"
            />

            <!-- Pita kiri -->
            <path
              d="M40 23C13 25 15 3 29 8C35 10 40 17 40 23Z"
              fill="url(#promo-gift-gold)"
              stroke="#3C1E66"
              stroke-width="2"
            />

            <!-- Pita kanan -->
            <path
              d="M40 23C67 25 65 3 51 8C45 10 40 17 40 23Z"
              fill="url(#promo-gift-gold)"
              stroke="#3C1E66"
              stroke-width="2"
            />

            <circle
              cx="40" cy="23"
              r="6"
              fill="#FCD757"
              stroke="#3C1E66"
              stroke-width="1.5"
            />

            <!-- Highlight -->
            <path
              d="M19 43V59"
              stroke="#D8C2EE"
              stroke-width="3"
              stroke-linecap="round"
              opacity=".8"
            />

            <path
              d="M15 28H27"
              stroke="#FFFFFF"
              stroke-width="2"
              stroke-linecap="round"
              opacity=".7"
            />

          </svg>

        </div>

        <div class="promo-smart-card-content">

          <h3>Paket 2 Pilar</h3>

          <p>
            Diskon untuk pendaftaran dua pilar sekaligus,
            misalnya Tahfidz + Academic atau English + AI.
            Besaran diskon dapat ditanyakan melalui
            CS WhatsApp.
          </p>

        </div>

      </article>

      <!-- DISKON SANTRI INTERNAL -->
      <article class="promo-smart-card">

        <div class="promo-smart-icon" aria-hidden="true">

          <!-- ILUSTRASI TOGA -->
          <svg viewBox="0 0 80 80" fill="none">

            <defs>
              <linearGradient id="promo-cap-top" x1="0" y1="0" x2="1" y2="1">
                <stop stop-color="#B98FDD" />
                <stop offset=".45" stop-color="#7E55B3" />
                <stop offset="1" stop-color="#3C1E66" />
              </linearGradient>

              <linearGradient id="promo-cap-body" x1="0" y1="0" x2="0" y2="1">
                <stop stop-color="#7E55B3" />
                <stop offset="1" stop-color="#2A1548" />
              </linearGradient>

              <linearGradient id="promo-cap-gold" x1="0" y1="0" x2="1" y2="1">
                <stop stop-color="#FFF4C2" />
                <stop offset="1" stop-color="#D9A035" />
              </linearGradient>
            </defs>

            <ellipse
              cx="40" cy="67"
              rx="25" ry="4"
              fill="#3C1E66"
              opacity=".12"
            />

            <!-- Bagian bawah toga -->
            <path
              d="M19 34H61V53Q40 70 19 53Z"
              fill="#2A1548"
            />

            <path
              d="M19 30H61V48Q40 65 19 48Z"
              fill="url(#promo-cap-body)"
            />

            <!-- Bagian atas toga -->
            <path
              d="M4 28L40 11L76 28V33L40 51L4 33Z"
              fill="#2A1548"
            />

            <path
              d="M4 27L40 9L76 27L40 45Z"
              fill="url(#promo-cap-top)"
              stroke="#3C1E66"
              stroke-width="1.5"
              stroke-linejoin="round"
            />

            <!-- Highlight -->
            <path
              d="M10 27L40 13L69 27"
              stroke="#E3D4F3"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              opacity=".8"
            />

            <!-- Tali toga -->
            <path
              d="M40 26L65 37V54"
              stroke="#D9A035"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <ellipse
              cx="40" cy="26"
              rx="5" ry="3"
              fill="#FCD757"
            />

            <rect
              x="61" y="52"
              width="8" height="14"
              rx="4"
              fill="url(#promo-cap-gold)"
            />

          </svg>

        </div>

        <div class="promo-smart-card-content">

          <h3>Diskon Santri Internal</h3>

          <p>
            Potongan harga bagi santri aktif Paket A/B/C
            dan Homeschooling PKBM Al-Fatihah.
            Besaran potongan dapat ditanyakan melalui
            CS WhatsApp.
          </p>

        </div>

      </article>

    </div>

    <!-- KETERANGAN PROMO -->
    <div class="promo-smart-notes">

      <p>
        <strong>
          Semua promo, diskon, dan potongan berlaku sampai kuota terpenuhi.
        </strong>{" "}

        <span class="promo-smart-notes-text">
          Syarat dan ketentuan berlaku.
        </span>{" "}

        <span class="promo-smart-notes-text">
          Informasi lengkap hubungi
        </span>{" "}

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          CS WhatsApp
        </a><span class="promo-smart-notes-text">.</span>
      </p>

    </div>

  </div>
</section>