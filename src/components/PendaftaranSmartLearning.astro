
---
import "../styles/program/PendaftaranSmartLearning.css";

const whatsappUrl = "https://wa.me/6285319485269";
const formulirUrl = "/pendaftaran";

const langkahPendaftaran = [
  {
    nomor: "1",
    judul: "Konsultasi WhatsApp",
    deskripsi: "Hubungi 0853 1948 5269",
    link: whatsappUrl,
    linkText: "Chat WhatsApp",
    icon: "chat",
  },
  {
    nomor: "2",
    judul: "Pilih Program",
    deskripsi: "Pilih pilar, cara belajar, dan kelas",
    icon: "list",
  },
  {
    nomor: "3",
    judul: "Biaya Pendaftaran",
    deskripsi: "Bayar biaya pendaftaran Rp150.000",
    icon: "wallet",
  },
  {
    nomor: "4",
    judul: "Mulai Belajar",
    deskripsi: "Sesuai jadwal yang disepakati",
    icon: "book",
  },
  {
    nomor: "5",
    judul: "Isi Formulir",
    deskripsi: "Mengisi link pendaftaran PKBM Al-Fatihah",
    link: formulirUrl,
    linkText: "Buka Formulir",
    icon: "clipboard",
  },
];
---

<section
  class="pendaftaran-smart"
  id="pendaftaran-smart-learning"
  aria-labelledby="pendaftaran-smart-title"
>
  <div class="pendaftaran-smart-container">

    <!-- JUDUL SECTION -->
    <header class="pendaftaran-smart-heading">
      <h2 id="pendaftaran-smart-title">
        Bagaimana Cara Mendaftar?
      </h2>

      <span
        class="pendaftaran-smart-divider"
        aria-hidden="true"
      ></span>

      <p>Mudah, cukup ikuti langkah berikut.</p>
    </header>

    <!-- TIMELINE PENDAFTARAN -->
    <ol class="pendaftaran-smart-steps">

      {langkahPendaftaran.map((langkah) => (
        <li class="pendaftaran-smart-step">

          <!-- NOMOR -->
          <div class="pendaftaran-smart-number-wrap">
            <span class="pendaftaran-smart-number">
              {langkah.nomor}
            </span>
          </div>

          <!-- CARD -->
          <article class="pendaftaran-smart-card">

            <div class="pendaftaran-smart-icon" aria-hidden="true">

              <!-- WHATSAPP -->
              {langkah.icon === "chat" && (
                <svg viewBox="0 0 64 64" fill="none">
                  <defs>
                    <linearGradient id="daftar-chat-gradient"
                      x1="10" y1="5" x2="54" y2="60"
                      gradientUnits="userSpaceOnUse">
                      <stop stop-color="#70E99A" />
                      <stop offset="1" stop-color="#159A51" />
                    </linearGradient>
                  </defs>

                  <ellipse cx="32" cy="59" rx="20" ry="3"
                    fill="#3C1E66" opacity=".09" />

                  <path
                    d="M12 48 8 59l13-4a26 26 0 1 0-9-7Z"
                    fill="url(#daftar-chat-gradient)"
                    stroke="#16884A"
                    stroke-width="1.8"
                  />

                  <path
                    d="M22 17c-4 1-6 5-4 11 4 10 12 18 22 20 5 1 9-3 9-6l-10-5-4 4c-6-3-10-7-12-12l4-4-5-8Z"
                    fill="#FFFFFF"
                  />

                  <path
                    d="M15 22c3-7 9-12 17-13"
                    stroke="#FFFFFF"
                    stroke-width="3"
                    stroke-linecap="round"
                    opacity=".45"
                  />
                </svg>
              )}

              <!-- PILIH PROGRAM -->
              {langkah.icon === "list" && (
                <svg viewBox="0 0 64 64" fill="none">
                  <defs>
                    <linearGradient id="daftar-list-gradient"
                      x1="10" y1="5" x2="54" y2="60"
                      gradientUnits="userSpaceOnUse">
                      <stop stop-color="#9D7CC7" />
                      <stop offset="1" stop-color="#60358E" />
                    </linearGradient>
                  </defs>

                  <ellipse cx="32" cy="59" rx="21" ry="3"
                    fill="#3C1E66" opacity=".09" />

                  <rect x="12" y="7" width="40" height="49" rx="7"
                    fill="#3C1E66" />

                  <rect x="12" y="4" width="40" height="49" rx="7"
                    fill="url(#daftar-list-gradient)"
                    stroke="#60358E" stroke-width="1.5" />

                  <rect x="17" y="10" width="30" height="37" rx="3"
                    fill="#FFF9F5" />

                  <path d="m21 20 3 3 5-6M21 31l3 3 5-6M21 42l3 3 5-6"
                    stroke="#D9A035" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round" />

                  <path d="M33 21h9M33 32h9M33 43h9"
                    stroke="#60358E" stroke-width="2.5"
                    stroke-linecap="round" />
                </svg>
              )}

              <!-- BIAYA PENDAFTARAN -->
              {langkah.icon === "wallet" && (
                <svg viewBox="0 0 64 64" fill="none">
                  <defs>
                    <linearGradient id="daftar-wallet-gradient"
                      x1="5" y1="10" x2="58" y2="58"
                      gradientUnits="userSpaceOnUse">
                      <stop stop-color="#8F6CC2" />
                      <stop offset="1" stop-color="#4A2672" />
                    </linearGradient>

                    <linearGradient id="daftar-coin-gradient"
                      x1="20" y1="3" x2="45" y2="33"
                      gradientUnits="userSpaceOnUse">
                      <stop stop-color="#FFE88B" />
                      <stop offset="1" stop-color="#D9A035" />
                    </linearGradient>
                  </defs>

                  <ellipse cx="32" cy="59" rx="24" ry="3"
                    fill="#3C1E66" opacity=".09" />

                  <rect x="7" y="18" width="47" height="36" rx="8"
                    fill="#3C1E66" />

                  <circle cx="35" cy="16" r="13"
                    fill="url(#daftar-coin-gradient)"
                    stroke="#D9A035" stroke-width="2" />

                  <text x="35" y="20"
                    text-anchor="middle"
                    font-size="11"
                    font-weight="700"
                    fill="#92600B">Rp</text>

                  <rect x="5" y="23" width="50" height="30" rx="7"
                    fill="url(#daftar-wallet-gradient)"
                    stroke="#60358E" stroke-width="1.5" />

                  <rect x="39" y="32" width="20" height="14" rx="5"
                    fill="#6B4296"
                    stroke="#3C1E66" stroke-width="1.5" />

                  <circle cx="46" cy="39" r="3"
                    fill="#FFD76A" />

                  <path d="M12 29h18"
                    stroke="#C8AEE8" stroke-width="2.5"
                    stroke-linecap="round" />
                </svg>
              )}

              <!-- MULAI BELAJAR -->
              {langkah.icon === "book" && (
                <svg viewBox="0 0 64 64" fill="none">
                  <defs>
                    <linearGradient id="daftar-book-gradient"
                      x1="5" y1="12" x2="60" y2="54"
                      gradientUnits="userSpaceOnUse">
                      <stop stop-color="#8F6CC2" />
                      <stop offset="1" stop-color="#60358E" />
                    </linearGradient>
                  </defs>

                  <ellipse cx="32" cy="58" rx="25" ry="3"
                    fill="#3C1E66" opacity=".09" />

                  <path
                    d="M5 13c10-3 18-1 27 5 9-6 17-8 27-5v35c-10-3-18-1-27 6-9-7-17-9-27-6V13Z"
                    fill="url(#daftar-book-gradient)"
                    stroke="#60358E" stroke-width="1.5"
                    stroke-linejoin="round"
                  />

                  <path
                    d="M10 8c8-2 15 0 22 6v34c-7-6-14-8-22-6V8Z"
                    fill="#FFF4DB"
                  />

                  <path
                    d="M32 14c7-6 14-8 22-6v34c-8-2-15 0-22 6V14Z"
                    fill="#FFFFFF"
                  />

                  <path d="M32 14v34"
                    stroke="#D9A035" stroke-width="2" />

                  <path
                    d="M15 18c4 0 8 1 12 4M15 26c4 0 8 1 12 4M15 34c4 0 8 1 12 4M37 22c4-3 8-4 12-4M37 30c4-3 8-4 12-4M37 38c4-3 8-4 12-4"
                    stroke="#8F6CC2" stroke-width="2"
                    stroke-linecap="round"
                  />

                  <path d="M42 9v17l4-3 4 3V8"
                    fill="#E7AD37" />
                </svg>
              )}

              <!-- FORMULIR -->
              {langkah.icon === "clipboard" && (
                <svg viewBox="0 0 64 64" fill="none">
                  <defs>
                    <linearGradient id="daftar-form-gradient"
                      x1="10" y1="5" x2="55" y2="60"
                      gradientUnits="userSpaceOnUse">
                      <stop stop-color="#9D7CC7" />
                      <stop offset="1" stop-color="#60358E" />
                    </linearGradient>
                  </defs>

                  <ellipse cx="32" cy="59" rx="21" ry="3"
                    fill="#3C1E66" opacity=".09" />

                  <rect x="11" y="8" width="42" height="49" rx="6"
                    fill="#3C1E66" />

                  <rect x="11" y="5" width="42" height="49" rx="6"
                    fill="url(#daftar-form-gradient)"
                    stroke="#60358E" stroke-width="1.5" />

                  <rect x="16" y="12" width="32" height="36" rx="3"
                    fill="#FFFFFF" />

                  <rect x="22" y="3" width="20" height="12" rx="4"
                    fill="#FFD76A"
                    stroke="#D9A035" stroke-width="1.5" />

                  <path d="M22 22h20M22 29h20M22 36h12"
                    stroke="#8F6CC2" stroke-width="2.5"
                    stroke-linecap="round" />

                  <path d="m38 40 4 4 8-10"
                    stroke="#D9A035" stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round" />
                </svg>
              )}

            </div>

            <!-- ISI CARD -->
            <h3>{langkah.judul}</h3>
            <p>{langkah.deskripsi}</p>

            {langkah.link && (
              <a
                class="pendaftaran-smart-link"
                href={langkah.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                {langkah.linkText}

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </a>
            )}

          </article>

        </li>
      ))}

    </ol>

  </div>
</section>
