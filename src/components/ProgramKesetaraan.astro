
---
import heroKesetaraan from "../assets/image/hero-kesetaraan.webp";
import bukuImage from "../assets/image/Stacked Orange and Purple Books.png";
import daunImage from "../assets/image/Overlapping Green Leaves with Soft Shadow.png";

import "../styles/program/ProgramKesetaraan.css";

const registrationUrl = "/pendaftaran";
const whatsappUrl = "https://wa.me/6285319485269";
---

<section
  class="program-kesetaraan"
  aria-labelledby="program-kesetaraan-title"
>
  <div class="program-kesetaraan-container">

    <!-- KONTEN KIRI -->

    <div class="program-kesetaraan-content">

      <!-- LABEL DAN AKREDITASI -->

      <div class="program-kesetaraan-meta">

        <span class="program-kesetaraan-label">
          PROGRAM KESETARAAN
        </span>

        <div class="program-kesetaraan-badge">

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="8" r="6" />
            <path d="m8.2 13.5-1 8 4.8-2.5 4.8 2.5-1-8" />
          </svg>

          <span>Terakreditasi A</span>

        </div>

      </div>

      <!-- JUDUL -->

      <h1 id="program-kesetaraan-title">
        Apa itu Program Kesetaraan
        <span>PKBM Alfatihah?</span>
      </h1>

      <!-- DESKRIPSI -->

      <p class="program-kesetaraan-description">
        Program Kesetaraan Kejar Paket A, B &amp; C adalah
        layanan pendidikan kesetaraan resmi dari PKBM Alfatihah
        untuk warga belajar yang ingin menyelesaikan pendidikan
        setara SD (Paket A), SMP (Paket B), dan SMA (Paket C).
        Belajar bisa secara online, offline, atau mandiri,
        dengan bekal nilai-nilai Islami.
      </p>

      <!-- TAGLINE -->

      <p class="program-kesetaraan-tagline">

        <span
          class="program-kesetaraan-check"
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m5 12 4 4L19 6" />
          </svg>
        </span>

        Solusi Pendidikan Fleksibel, Kredibel &amp; Islami

      </p>

      <!-- TOMBOL -->

      <div class="program-kesetaraan-actions">

        <a
          href={registrationUrl}
          class="program-kesetaraan-btn program-kesetaraan-btn-primary"
        >
          Daftar Sekarang

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>

        </a>

        <a
          href={whatsappUrl}
          class="program-kesetaraan-btn program-kesetaraan-btn-outline"
          target="_blank"
          rel="noopener noreferrer"
        >

          <svg
            class="program-kesetaraan-wa"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12.04 2a9.84 9.84 0 0 0-8.53 14.75L2 22l5.38-1.41A9.95 9.95 0 1 0 12.04 2Zm0 17.98a8 8 0 0 1-4.08-1.12l-.3-.18-3.19.84.85-3.1-.2-.32a8.04 8.04 0 1 1 6.92 3.88Zm4.41-6.02c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.65.58.25 1.03.4 1.38.51.58.18 1.1.16 1.51.1.46-.07 1.43-.59 1.63-1.15.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" />
          </svg>

          Konsultasi via WhatsApp

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>

        </a>

      </div>

    </div>

    <!-- FOTO KANAN -->

    <div class="program-kesetaraan-visual">

      <!-- DEKORASI PETIK KUNING -->

      <svg
        class="program-kesetaraan-petik"
        viewBox="0 0 80 80"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12 57L29 61 M24 25L39 42 M57 10L59 32"
          stroke="#FCD757"
          stroke-width="9"
          stroke-linecap="round"
        />
      </svg>

      <!-- BINGKAI FOTO -->

      <div class="program-kesetaraan-photo-frame">

        <img
          class="program-kesetaraan-photo"
          src={heroKesetaraan.src}
          width={heroKesetaraan.width}
          height={heroKesetaraan.height}
          alt="Peserta didik PKBM Alfatihah sedang membaca buku"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

      </div>

      <!-- DAUN HIJAU -->

      <img
        class="program-kesetaraan-daun"
        src={daunImage.src}
        width={daunImage.width}
        height={daunImage.height}
        alt=""
        aria-hidden="true"
        draggable="false"
      />

      <!-- TUMPUKAN BUKU -->

      <img
        class="program-kesetaraan-buku"
        src={bukuImage.src}
        width={bukuImage.width}
        height={bukuImage.height}
        alt=""
        aria-hidden="true"
        draggable="false"
      />

    </div>

  </div>

  <!-- GELOMBANG BAWAH SATU LAPIS -->

  <svg
    class="program-kesetaraan-wave"
    viewBox="0 0 1440 100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="
        M0 35
        C180 5 300 78 520 75
        C740 72 880 12 1080 25
        C1230 35 1330 65 1440 20
        V100 H0 Z
      "
    />
  </svg>

</section>
