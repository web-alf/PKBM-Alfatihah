
---
import "../styles/program/StudyGroupHomeschooling.css";

import peopleImage from "../assets/image/Layered Magenta People Icon.webp";
import booksImage from "../assets/image/Colorful Stacked Books with Green Leaves.webp";
import clipboardImage from "../assets/image/Vibrant 3D Clipboard Checklist Icon.webp";

const kelompok = [
  {
    siswa: "2 Siswa",
    persen: 75,
    warna: "ungu",
  },
  {
    siswa: "3 Siswa",
    persen: 62,
    warna: "ungu",
  },
  {
    siswa: "4 Siswa",
    persen: 54,
    warna: "ungu",
  },
  {
    siswa: "5 Siswa",
    persen: 48,
    warna: "emas",
  },
];

const biayaPendaftaran = [
  {
    label: "Administrasi",
    harga: "Rp150.000",
  },
  {
    label: "Rapor",
    harga: "Rp100.000",
  },
  {
    label: "Infaq",
    harga: "Rp1.000.000",
  },
];

const biayaLainnya = [
  {
    label: "Ujian / semester",
    harga: "Rp100.000",
  },
  {
    label: "Ijazah",
    harga: "Rp200.000",
  },
  {
    label: "Operasional offline / bulan",
    harga: "Rp100.000",
  },
  {
    label: "Tambahan jarak > 6 km / bulan",
    harga: "Rp100.000",
  },
];
---

<section
  class="study-hs"
  id="study-group-homeschooling"
  aria-labelledby="study-hs-title"
>

  <!-- BANNER JUDUL BERGELOMBANG -->
  <div class="study-hs-banner">

    <!-- GELOMBANG ATAS -->
    <svg
      class="study-hs-wave study-hs-wave-top"
      viewBox="0 0 1440 80"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0 0 H1440 V35
        C1280 0 1160 12 1010 35
        C830 65 730 5 560 20
        C380 42 280 65 150 30
        C90 15 40 20 0 35 Z"
      />
    </svg>

    <div class="study-hs-banner-inner">

      <!-- DEKORASI KIRI -->
      <img
        class="study-hs-people"
        src={peopleImage.src}
        alt=""
        loading="lazy"
        decoding="async"
      />

      <!-- JUDUL DAN DESKRIPSI -->
      <div class="study-hs-heading">
        <h2 id="study-hs-title">
          Study Group
        </h2>

        <span
          class="study-hs-heading-line"
          aria-hidden="true"
        ></span>

        <p>
          Belajar berkelompok dalam satu kelas, lebih
          interaktif dan kolaboratif. Online via Zoom,
          atau offline di lokasi yang disepakati
          peserta dan tutor.
        </p>
      </div>

      <!-- DEKORASI KANAN -->
      <img
        class="study-hs-books"
        src={booksImage.src}
        alt=""
        loading="lazy"
        decoding="async"
      />

    </div>

    <!-- GELOMBANG BAWAH -->
    <svg
      class="study-hs-wave study-hs-wave-bottom"
      viewBox="0 0 1440 80"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0 35
        C180 70 300 5 480 30
        C660 55 790 70 960 35
        C1140 0 1280 65 1440 25
        V80 H0 Z"
      />
    </svg>

  </div>

  <!-- KONTEN UTAMA -->
  <div class="study-hs-container">

    <div class="study-hs-content">

      <!-- DIAGRAM BATANG -->
      <div class="study-hs-chart-section">

        <div class="study-hs-chart-heading">
          <h3>Biaya Berdasarkan Jumlah Siswa</h3>
          <p>Persentase dari biaya individu</p>
        </div>

        <div
          class="study-hs-chart"
          role="img"
          aria-label="Perbandingan biaya Study Group: 2 siswa membayar 75 persen, 3 siswa 62 persen, 4 siswa 54 persen, dan 5 siswa 48 persen dari biaya individu."
        >
          {
            kelompok.map((item, index) => (
              <div class="study-hs-bar-group">

                <span class="study-hs-student">
                  {item.siswa}
                </span>

                <div
                  class:list={[
                    "study-hs-bar",
                    item.warna === "emas" &&
                      "study-hs-bar-gold",
                  ]}
                  style={`--bar-height: ${item.persen}%; --bar-delay: ${index * 0.12}s`}
                >
                  <div class="study-hs-bar-content">

                    <strong class="study-hs-percent">
                      {item.persen}%
                    </strong>

                    <span class="study-hs-bar-caption">
                      dari biaya individu
                    </span>

                  </div>
                </div>

              </div>
            ))
          }
        </div>

      </div>

      <!-- RINCIAN BIAYA -->
      <div class="study-hs-fees">

        <h3 class="study-hs-fees-heading">
          Rincian Biaya Study Group
        </h3>

        <div class="study-hs-fees-layout">

          <div class="study-hs-fee-cards">

            <!-- BIAYA PENDAFTARAN -->
            <div class="study-hs-detail">

              <div class="study-hs-detail-heading">

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="5" y="4" width="14" height="17" rx="2"/>
                  <path d="M9 4V2h6v2M9 9h6M9 13h6M9 17h4"/>
                </svg>

                <h4>Biaya Pendaftaran</h4>

              </div>

              <div class="study-hs-divider"></div>

              <div class="study-hs-fee-list">
                {
                  biayaPendaftaran.map((biaya) => (
                    <div class="study-hs-fee-row">
                      <span>{biaya.label}</span>
                      <strong>{biaya.harga}</strong>
                    </div>
                  ))
                }
              </div>

              <p class="study-hs-registration-note">
                SPP bulan pertama menyesuaikan
                jumlah peserta.
              </p>

            </div>

            <!-- BIAYA LAINNYA -->
            <div class="study-hs-detail">

              <div class="study-hs-detail-heading">

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="7" width="18" height="14" rx="2"/>
                  <path d="M8 7V4h8v3M3 12h18M10 12v2h4v-2"/>
                </svg>

                <h4>Biaya Lainnya</h4>

              </div>

              <div class="study-hs-divider"></div>

              <div class="study-hs-fee-list">
                {
                  biayaLainnya.map((biaya) => (
                    <div class="study-hs-fee-row">
                      <span>{biaya.label}</span>
                      <strong>{biaya.harga}</strong>
                    </div>
                  ))
                }
              </div>

            </div>

          </div>

          <!-- DEKORASI CLIPBOARD -->
          <div class="study-hs-clipboard-wrap">
            <img
              class="study-hs-clipboard"
              src={clipboardImage.src}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<script>
  function initStudyChart() {
    const chart = document.querySelector(
      "#study-group-homeschooling .study-hs-chart"
    );

    if (!(chart instanceof HTMLElement)) return;

    if (chart.dataset.initialized === "true") return;

    chart.dataset.initialized = "true";

    if ("IntersectionObserver" in window) {

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {

            chart.classList.add("is-visible");

            observer.unobserve(chart);

          }
        },
        {
          threshold: 0.2,
        }
      );

      chart.classList.add("is-animated");

      observer.observe(chart);

    } else {

      chart.classList.add("is-visible");

    }
  }

  initStudyChart();

  document.addEventListener(
    "astro:page-load",
    initStudyChart
  );
</script>
