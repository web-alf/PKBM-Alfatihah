
---
import "../styles/program/PromoDiaspora.css";
---

<section
  class="promo-diaspora"
  id="promo-diaspora"
  aria-labelledby="promo-diaspora-title"
>
  <div class="promo-diaspora-container">

    <div class="promo-diaspora-box">

      <h2 id="promo-diaspora-title">
        Biaya pendaftaran
      </h2>

      <div class="promo-diaspora-prices">
        <span class="promo-diaspora-old-price">
          Rp300.000
        </span>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>

        <strong class="promo-diaspora-new-price">
          Rp150.000
        </strong>
      </div>

      <span class="promo-diaspora-badge">
        Diskon 50% semua ukuran kelas
      </span>

      <p class="promo-diaspora-note">
        Syarat dan ketentuan berlaku. Informasi lengkap hubungi CS WhatsApp.
      </p>

      <a
        class="promo-diaspora-button"
        href="https://wa.me/6285319485269"
        target="_blank"
        rel="noopener noreferrer"
      >
        Hubungi CS WhatsApp

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>

    </div>

  </div>
</section>
