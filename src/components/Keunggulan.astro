// DATA KEUNGGULAN
const keunggulan = [
  {
    icon: "award",
    title: "Terakreditasi A",
  },
  {
    icon: "guru",
    title: "Dibimbing oleh guru yang berpengalaman",
  },
  {
    icon: "laptop",
    title: "Belajar bisa di mana saja",
  },
  {
    icon: "daun",
    title: "Menanamkan nilai-nilai Islami",
  },
  {
    icon: "jam",
    title: "Waktu belajar yang fleksibel",
  },
  {
    icon: "chat",
    title: "Layanan konseling secara berkala",
  },
  {
    icon: "koin",
    title: "Investasi yang terjangkau",
  },
  {
    icon: "bintang",
    title: "Belajar sesuai bakat dan minat",
  },
  {
    icon: "buku",
    title: "Penerapan Bahasa Arab dan Inggris sehari-hari",
  },
  {
    icon: "ijazah",
    title: "Memiliki ijazah yang legal",
  },
];
---

<section
  class="keunggulan-section"
  id="keunggulan"
  aria-labelledby="keunggulan-title"
>
  <div class="keunggulan-container">

    <!-- JUDUL SECTION -->
    <div class="keunggulan-heading">

      <h2 id="keunggulan-title">
        Kenapa memilih PKBM Alfatihah?
      </h2>

      <div class="keunggulan-line"></div>

    </div>

    <!-- GRID KEUNGGULAN -->
    <div class="keunggulan-grid">

      {
        keunggulan.map((item) => (
          <article
            class:list={[
              "keunggulan-card",
              `keunggulan-card--${item.icon}`,
            ]}
          >

            <!-- IKON DENGAN BACKGROUND PASTEL -->
            <div class="keunggulan-icon-wrap">

              <svg
                class="keunggulan-icon"
                viewBox="0 0 64 64"
                aria-hidden="true"
                focusable="false"
                set:html={icons[item.icon]}
              />

            </div>

            <!-- JUDUL KEUNGGULAN -->
            <h3>{item.title}</h3>

          </article>
        ))
      }

    </div>

  </div>

</section>
