    '<path d="M10 44v6c0 4 10 7 22 7s22-3 22-7v-6z" fill="#E8A600"/><ellipse cx="32" cy="44" rx="22" ry="8" fill="#FFC400"/><path d="M10 32v6c0 4 10 7 22 7s22-3 22-7v-6z" fill="#E8A600"/><ellipse cx="32" cy="32" rx="22" ry="8" fill="#FFD54A"/><path d="M10 20v6c0 4 10 7 22 7s22-3 22-7v-6z" fill="#E8A600"/><ellipse cx="32" cy="20" rx="22" ry="8" fill="#FFE27A"/><ellipse cx="32" cy="20" rx="12" ry="4" fill="#FFC400"/>',

