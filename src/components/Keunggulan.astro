
---
import "../styles/home/Keunggulan.css";

const keunggulan = [
  {
    icon: "award",
    title: "Terakreditasi A",
    color: "gold",
  },
  {
    icon: "heart",
    title: "Dibimbing oleh guru yang berpengalaman",
    color: "gold",
  },
  {
    icon: "monitor",
    title: "Belajar bisa di mana saja",
    color: "gold",
  },
  {
    icon: "heart-handshake",
    title: "Menanamkan nilai-nilai Islami",
    color: "gold",
  },
  {
    icon: "clock",
    title: "Waktu belajar yang fleksibel",
    color: "gold",
  },
  {
    icon: "messages-square",
    title: "Layanan konseling secara berkala",
    color: "gold",
  },
  {
    icon: "hand-coins",
    title: "Investasi yang terjangkau",
    color: "gold",
  },
  {
    icon: "badge-check",
    title: "Belajar sesuai bakat dan minat",
    color: "gold",
  },
  {
    icon: "book-open",
    title: "Penerapan Bahasa Arab dan Inggris sehari-hari",
    color: "gold",
  },
  {
    icon: "graduation-cap",
    title: "Memiliki ijazah yang legal",
    color: "gold",
  },
];
---

<section class="keunggulan-section" id="keunggulan">
  <div class="keunggulan-container">
    <div class="keunggulan-heading">
      <h2>Kenapa memilih PKBM Alfatihah?</h2>

      <div class="keunggulan-line"></div>
    </div>

    <div class="keunggulan-grid">
      {
        keunggulan.map((item) => (
          <article class="keunggulan-card">
            <div class:list={["keunggulan-icon", item.color]}>
              {item.icon === "award" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="6" />
                  <path d="m8.2 13.5-1 8 4.8-2.5 4.8 2.5-1-8" />
                  <path d="m12 5.5.8 1.6 1.8.3-1.3 1.3.3 1.8L12 9.7l-1.6.8.3-1.8-1.3-1.3 1.8-.3z" />
                </svg>
              )}

              {item.icon === "heart" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                </svg>
              )}

              {item.icon === "monitor" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="14" rx="2" />
                  <path d="M8 21h8M12 17v4" />
                </svg>
              )}

              {item.icon === "heart-handshake" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              )}

              {item.icon === "clock" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                  <path d="M12 1v2M23 12h-2" />
                </svg>
              )}

              {item.icon === "messages-square" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 3H5a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h2l4 4v-4h3a3 3 0 0 0 3-3V6a3 3 0 0 0-3-3Z" />
                  <path d="M18 7h1a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3h-2" />
                </svg>
              )}

              {item.icon === "hand-coins" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="17" cy="6" r="3" />
                  <path d="M3 13h5l3 2h4a2 2 0 0 1 0 4H9l-4-2H3" />
                  <path d="m3 11-2 2v6l2 2M12 12l3-2h4a2 2 0 0 1 2 2c0 .6-.3 1.1-.7 1.5" />
                </svg>
              )}

              {item.icon === "badge-check" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 2 3 2 3.6.4.4 3.6 2 3-2 3-.4 3.6-3.6.4-3 2-3-2-3.6-.4L5 14l-2-3 2-3 .4-3.6L9 4z" />
                  <path d="m9 11 2 2 4-4" />
                </svg>
              )}

              {item.icon === "book-open" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 6c-3-2-6-2-10-1v14c4-1 7-1 10 1 3-2 6-2 10-1V5c-4-1-7-1-10 1Z" />
                  <path d="M12 6v14M5 9h4M15 9h4M15 12h4" />
                </svg>
              )}

              {item.icon === "graduation-cap" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m2 9 10-5 10 5-10 5L2 9Z" />
                  <path d="M6 11v6c3.5 3 8.5 3 12 0v-6M22 9v7" />
                </svg>
              )}
            </div>

            <h3>{item.title}</h3>
          </article>
        ))
      }
    </div>
  </div>
</section>
