    spp: "Rp500.000",
    biayaPendaftaran: [
      { label: "Administrasi", harga: "Rp150.000" },
      { label: "Rapor", harga: "Rp100.000" },
      {
        label: "Infaq Pengembangan PKBM",
        harga: "Rp1.000.000",
      },
      {
        label: "SPP bulan pertama",
        harga: "Rp500.000",
      },
    ],
    biayaSPP: [
      {
        label: "KBM 3x per minggu",
        harga: "Rp480.000",
      },
      {
        label: "Operasional Jarak",
        harga: "Rp20.000",
      },
    ],
    catatan: "",
    ujian: "Rp100.000",
    ijazah: "Rp150.000",
  },
  {
    nama: "Kelas Offline: Tutor ke Rumah",
    lokasi: "Wilayah Semarang Timur",
    pendaftaran: "Rp1.850.000",
    spp: "Rp500.000 / Rp600.000",
    biayaPendaftaran: [
      { label: "Administrasi", harga: "Rp150.000" },
      { label: "Rapor", harga: "Rp100.000" },
      {
        label: "Infaq Pengembangan PKBM",
        harga: "Rp1.000.000",
      },
      {
        label: "SPP bulan pertama",
        harga: "Rp600.000",
      },
    ],
    biayaSPP: [
      {
        label: "KBM 3x per minggu",
        harga: "Rp500.000",
      },
      {
        label: "Tambahan jarak lebih dari 6 km",
        harga: "Rp100.000",
      },
    ],
    catatan:
      "Total Rp500.000 untuk jarak ≤ 6 km / Rp600.000 untuk jarak > 6 km.",
    ujian: "Rp100.000",
    ijazah: "Rp150.000",
  },
  {
    nama: "Kelas Mandiri / Self-Paced",
    lokasi: "",
