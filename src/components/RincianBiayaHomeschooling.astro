    lokasi: "",
    pendaftaran: "Rp1.700.000",
    spp: "Rp450.000",
    biayaPendaftaran: [
      { label: "Administrasi", harga: "Rp150.000" },
      { label: "Rapor", harga: "Rp100.000" },
      {
        label: "Infaq Pengembangan PKBM",
        harga: "Rp1.000.000",
      },
      {
