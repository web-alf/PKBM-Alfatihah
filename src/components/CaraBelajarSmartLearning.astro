
---
import "../styles/program/CaraBelajarSmartLearning.css";
---

<section
  class="cara-smart"
  id="cara-belajar-smart-learning"
  aria-labelledby="cara-smart-title"
>
  <div class="cara-smart-container">

    <!-- JUDUL SECTION -->
    <div class="cara-smart-heading">
      <h2 id="cara-smart-title">
        Pilih cara belajar yang paling pas
      </h2>
      <span class="cara-smart-divider" aria-hidden="true"></span>
    </div>

    <!-- KONTEN UTAMA -->
    <div class="cara-smart-layout">

      <!-- EMPAT PILIHAN BELAJAR -->
      <div class="cara-smart-grid">

        <!-- PRIVATE CLASS -->
        <article class="cara-smart-card">
          <div class="cara-smart-card-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <circle cx="15" cy="14" r="6"
                stroke="currentColor" stroke-width="2" />
              <circle cx="33" cy="14" r="6"
                stroke="currentColor" stroke-width="2" />
              <path d="M4 35v-5a11 11 0 0 1 22 0v5M22 35v-5a11 11 0 0 1 22 0v5"
                stroke="currentColor" stroke-width="2"
                stroke-linecap="round" />
              <path d="M4 38h40"
                stroke="#D9A035" stroke-width="2.5"
                stroke-linecap="round" />
            </svg>
          </div>

          <div class="cara-smart-card-content">
            <h3>Private Class</h3>
            <p>Tatap muka 1 lawan 1 di PKBM Al-Fatihah.</p>
          </div>
        </article>

        <!-- ONLINE PRIVATE -->
        <article class="cara-smart-card">
          <div class="cara-smart-card-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <rect x="7" y="8" width="34" height="26" rx="2"
                stroke="currentColor" stroke-width="2" />
              <path d="M3 39h42l-4-5H7l-4 5Z"
                stroke="currentColor" stroke-width="2"
                stroke-linejoin="round" />
              <path d="m21 16 10 5-10 5V16Z"
                fill="#D9A035" />
            </svg>
          </div>

          <div class="cara-smart-card-content">
            <h3>Online Private</h3>
            <p>Sesi daring yang fleksibel, tanpa batas jarak.</p>
          </div>
        </article>

        <!-- HOME PRIVATE -->
        <article class="cara-smart-card">
          <div class="cara-smart-card-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <path d="M5 23 24 7l19 16"
                stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round" />
              <path d="M10 21v21h28V21"
                stroke="currentColor" stroke-width="2"
                stroke-linejoin="round" />
              <rect x="19" y="28" width="10" height="14"
                stroke="currentColor" stroke-width="2" />
              <rect x="31" y="26" width="5" height="6"
                fill="#D9A035" />
            </svg>
          </div>

          <div class="cara-smart-card-content">
            <h3>Home Private</h3>
            <p>Tutor datang ke rumah.</p>
            <p class="cara-smart-extra">
              +Rp15.000 per pertemuan
            </p>
          </div>
        </article>

        <!-- LEARNING CENTER -->
        <article class="cara-smart-card cara-smart-card-location">
          <div class="cara-smart-card-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <path d="M24 42s14-13 14-25a14 14 0 0 0-28 0c0 12 14 25 14 25Z"
                stroke="currentColor" stroke-width="2.5"
                stroke-linejoin="round" />
              <circle cx="24" cy="17" r="5"
                fill="#D9A035" />
            </svg>
          </div>

          <div class="cara-smart-card-content">
            <h3>Learning Center</h3>
            <p>Belajar di cabang PKBM terdekat.</p>

            <p class="cara-smart-extra">
              +Rp30.000 per kelas per pertemuan
            </p>

            <p class="cara-smart-address">
              <strong>Lokasi:</strong>
              Jl. Ngablak Indah II No. 24A,
              Bangetayu Kulon, Kec. Genuk,
              Kota Semarang, Jawa Tengah 50115.
            </p>
          </div>
        </article>

      </div>

      <!-- PILIHAN KELAS -->
      <aside
        class="cara-smart-classes"
        aria-labelledby="cara-smart-classes-title"
      >
        <h3 id="cara-smart-classes-title">
          Pilihan kelas
        </h3>

        <span class="cara-smart-classes-line" aria-hidden="true"></span>

        <div class="cara-smart-class-list">

          <div class="cara-smart-class-item">
            <div class="cara-smart-class-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="7" r="4"
                  stroke="currentColor" stroke-width="1.7" />
                <path d="M4 22v-3a8 8 0 0 1 16 0v3"
                  stroke="currentColor" stroke-width="1.7" />
              </svg>
            </div>
            <p><strong>Private</strong> – 1 murid</p>
          </div>

          <div class="cara-smart-class-item">
            <div class="cara-smart-class-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="6" r="3"
                  stroke="currentColor" stroke-width="1.6" />
                <circle cx="4.5" cy="10" r="2.5"
                  stroke="currentColor" stroke-width="1.6" />
                <circle cx="19.5" cy="10" r="2.5"
                  stroke="currentColor" stroke-width="1.6" />
                <path d="M6 22v-4a6 6 0 0 1 12 0v4M1 22v-5a4 4 0 0 1 4-4M23 22v-5a4 4 0 0 0-4-4"
                  stroke="currentColor" stroke-width="1.6" />
              </svg>
            </div>
            <p><strong>Semi Private</strong> – 4–6 murid</p>
          </div>

          <div class="cara-smart-class-item">
            <div class="cara-smart-class-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="5" r="3"
                  stroke="currentColor" stroke-width="1.6" />
                <circle cx="4.5" cy="9" r="2.5"
                  stroke="currentColor" stroke-width="1.6" />
                <circle cx="19.5" cy="9" r="2.5"
                  stroke="currentColor" stroke-width="1.6" />
                <path d="M6 22v-4a6 6 0 0 1 12 0v4M1 22v-6a4 4 0 0 1 5-4M23 22v-6a4 4 0 0 0-5-4"
                  stroke="currentColor" stroke-width="1.6" />
              </svg>
            </div>
            <p><strong>Reguler</strong> – lebih dari 15 murid</p>
          </div>

        </div>
      </aside>

    </div>

    <!-- DURASI -->
    <div class="cara-smart-duration">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l4 2" />
      </svg>

      <p>Durasi 60 menit per pertemuan</p>
    </div>

  </div>
</section>
