---
import "../styles/program/ProgramHomeschooling.css";
import gambarHomeschooling from "../assets/image/homeschooling.webp";

const linkPendaftaran = "/pendaftaran";
const linkWhatsApp = "https://wa.me/6285319485269";
---

<section
  class="homeschooling-hero"
  aria-labelledby="homeschooling-hero-title"
>
  <div class="homeschooling-hero-container">

    <!-- KONTEN HERO -->
    <div class="homeschooling-hero-content">

      <!-- LABEL DAN BADGE -->
      <div class="homeschooling-hero-labels">
        <span class="homeschooling-label">
          ALFATIHAH HOMESCHOOLING
        </span>

        <span class="homeschooling-badge">
          <svg
            viewBox="0 0 24 24"
            width="17"
            height="17"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="8" r="6" />
            <path d="m8.2 13-1 9 4.8-3 4.8 3-1-9" />
          </svg>
          Terakreditasi A
        </span>
      </div>

      <!-- JUDUL -->
      <h1 id="homeschooling-hero-title">
        Apa itu
        <span class="homeschooling-hero-title-gold">
          Alfatihah Homeschooling?
        </span>
      </h1>

      <!-- GARIS PEMBATAS -->
      <div
        class="homeschooling-hero-divider"
        aria-hidden="true"
      ></div>

      <!-- DESKRIPSI -->
      <p class="homeschooling-hero-description">
        Alfatihah Homeschooling adalah layanan pendidikan alternatif resmi dari
        PKBM Al-Fatihah dengan pendekatan personal, menggunakan Kurikulum
        Nasional yang disetarakan dengan pendidikan formal. Belajar bisa
        secara online, di lembaga, tutor ke rumah, mandiri, atau berkelompok.
      </p>

      <!-- TAGLINE -->
      <p class="homeschooling-hero-tagline">
        Pendidikan Resmi, Terakreditasi A, Fleksibel, dan Islami
      </p>

      <!-- TOMBOL -->
      <div class="homeschooling-hero-actions">

        <a
          href={linkPendaftaran}
          target="_blank"
          rel="noopener noreferrer"
          class="homeschooling-btn homeschooling-btn-primary"
        >
          Daftar Sekarang
          <span aria-hidden="true">→</span>
        </a>

        <a
          href={linkWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="homeschooling-btn homeschooling-btn-secondary"
        >
          <svg
            viewBox="0 0 24 24"
            width="19"
            height="19"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.45 0 .07 5.37.06 11.97c0 2.11.55 4.17 1.59 5.99L0 24l6.2-1.62a12.04 12.04 0 0 0 5.84 1.49h.01c6.6 0 11.98-5.37 11.99-11.97a11.9 11.9 0 0 0-3.52-8.42ZM12.05 21.85a9.94 9.94 0 0 1-5.07-1.39l-.36-.21-3.68.96.98-3.58-.23-.37a9.94 9.94 0 0 1-1.52-5.29c0-5.49 4.47-9.95 9.96-9.95a9.9 9.9 0 0 1 7.04 2.92 9.9 9.9 0 0 1 2.91 7.04c0 5.49-4.47 9.95-9.95 9.95Zm5.46-7.45c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.11 3.22 5.11 4.51.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"
            />
          </svg>

          Konsultasi via WhatsApp
        </a>

      </div>
    </div>

    <!-- VISUAL HERO -->
    <div class="homeschooling-hero-visual">

      <!-- DEKORASI AWAN -->
      <svg
        class="homeschooling-cloud"
        viewBox="0 0 140 70"
        aria-hidden="true"
      >
        <path
          d="M18 60C-3 60 0 32 21 30C20 7 57-1 69 25C88 9 112 23 111 39C143 32 151 60 127 60Z"
          fill="#EBC5E4"
        />
      </svg>

      <!-- FOTO HOMESCHOOLING -->
      <div class="homeschooling-photo-wrap">
        <div class="homeschooling-photo-frame">
          <img
            src={gambarHomeschooling.src}
            alt="Alfatihah Homeschooling"
            width={gambarHomeschooling.width}
            height={gambarHomeschooling.height}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

    </div>

  </div>

  <!-- GELOMBANG BAWAH -->
  <svg
    class="homeschooling-hero-wave"
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M0 42
         C180 95 350 12 560 48
         C760 85 870 105 1060 58
         C1220 18 1340 25 1440 48
         V120 H0Z"
    />
  </svg>

</section>