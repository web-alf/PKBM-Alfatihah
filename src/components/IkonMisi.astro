---
// Ikon misi & visi: 24x24, stroke 1.7, gaya konsisten. Warna lewat CSS (currentColor).
const { name, class: className = "" } = Astro.props;
---

<svg
  class:list={["ikon-misi", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "target" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="5" />
      <circle cx="12" cy="12" r="1.2" fill="currentColor" />
      <path d="M12 12L20 4M17 3.5V7H20.5" />
    </>
  )}
  {name === "quran" && (
    <>
      <path d="M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5C17 4.5 14 5 12 6.5Z" fill="currentColor" fill-opacity="0.12" />
      <path d="M12 6.5v13M6 8.5c1.5 0 3 .2 4 .7M6 12c1.5 0 3 .2 4 .7M18 8.5c-1.5 0-3 .2-4 .7M18 12c-1.5 0-3 .2-4 .7" />
    </>
  )}
  {name === "ide" && (
    <>
      <path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z" fill="currentColor" fill-opacity="0.2" />
      <path d="M9.5 18.5h5M10.5 21h3M12 6.5v3M9.5 9.5L12 12l2.5-2.5" />
    </>
  )}
  {name === "laptop" && (
    <>
      <rect x="4.5" y="5" width="15" height="11" rx="2" fill="currentColor" fill-opacity="0.14" />
      <path d="M2.5 19.5h19M9.5 19.5l.5-1.5h4l.5 1.5M8 9h8M8 12h5" />
    </>
  )}
  {name === "komunitas" && (
    <>
      <circle cx="12" cy="8" r="3" fill="currentColor" fill-opacity="0.14" />
      <path d="M6.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5" />
      <circle cx="5" cy="10" r="2" />
      <path d="M1.5 18c0-2.2 1.6-3.8 3.6-4" />
      <circle cx="19" cy="10" r="2" />
      <path d="M22.5 18c0-2.2-1.6-3.8-3.6-4" />
    </>
  )}
  {name === "tumbuh" && (
    <>
      <rect x="4" y="13" width="3.5" height="7" rx="1" fill="currentColor" fill-opacity="0.14" />
      <rect x="10.25" y="10" width="3.5" height="10" rx="1" fill="currentColor" fill-opacity="0.14" />
      <rect x="16.5" y="12" width="3.5" height="8" rx="1" fill="currentColor" fill-opacity="0.14" />
      <path d="M3 8.5l5-3 4 2.5 8-5M16 3h4.5v4.5" />
    </>
  )}
</svg>
